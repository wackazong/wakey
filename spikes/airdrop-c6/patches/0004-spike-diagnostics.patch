+/* Spike diagnostics: what lwIP transmits, by kind (awdl_tx_census_read). */
+enum { TXC_TCP, TXC_MDNS, TXC_UDP, TXC_NS, TXC_NA, TXC_MLD, TXC_ICMP, TXC_OTHER, TXC_N };
+static volatile uint32_t g_tx_census[TXC_N];
+static volatile uint32_t g_tcp_census[5];   /* rst, syn, fin, data, pure ack */
+extern "C" void awdl_tcp_census_read(uint32_t out[5]) { for (int i = 0; i < 5; i++) out[i] = g_tcp_census[i]; }
+extern "C" void awdl_tx_census_read(uint32_t out[8]) { for (int i = 0; i < TXC_N; i++) out[i] = g_tx_census[i]; }
+static void tx_census(const uint8_t *ip, int len) {
+  if (len < 40) { g_tx_census[TXC_OTHER]++; return; }
+  uint8_t nh = ip[6];
+  const uint8_t *l4 = ip + 40;
+  if (nh == 0) { g_tx_census[TXC_MLD]++; return; }       /* hop-by-hop: MLD reports */
+  if (nh == 6) {
+    g_tx_census[TXC_TCP]++;
+    if (len >= 60) {
+      uint8_t fl = l4[13];
+      int hl = (l4[12] >> 4) * 4, payload = ((ip[4] << 8) | ip[5]) - hl;
+      g_tcp_census[fl & 0x04 ? 0 : fl & 0x02 ? 1 : fl & 0x01 ? 2 : payload > 0 ? 3 : 4]++;
+    }
+    return;
+  }
+  if (nh == 17) { g_tx_census[len >= 44 && ((l4[2] << 8) | l4[3]) == 5353 ? TXC_MDNS : TXC_UDP]++; return; }
+  if (nh == 58 && len >= 41) {
+    g_tx_census[l4[0] == 135 ? TXC_NS : l4[0] == 136 ? TXC_NA : l4[0] == 143 ? TXC_MLD : TXC_ICMP]++;
+    return;
+  }
+  g_tx_census[TXC_OTHER]++;
+}
