 // ---- promiscuous RX callback (core 0, WiFi task) — KEEP MINIMAL -------------
 static volatile uint32_t g_rx_ucast, g_rx_ucast_retry;
+/* Unicast data for us by PHY format (RX_BB_FORMAT_*: 0 11b, 1 11g, 2 HT, 3 VHT, 4 HE SU,
+   5 HE MU, 6 HE ER SU, 7 HE TB; ESP32-C6 and other HE parts) and the last L-SIG rate. */
+static volatile uint32_t g_rx_format[8];
+static volatile uint8_t g_rx_last_rate;
+extern "C" void awdl_rx_format_read(uint32_t out[8], uint8_t *last_rate) {
+  for (int i = 0; i < 8; i++) out[i] = g_rx_format[i];
+  *last_rate = g_rx_last_rate;
+}
 extern "C" void awdl_rx_ucast_read(uint32_t *n, uint32_t *retry) { *n = g_rx_ucast; *retry = g_rx_ucast_retry; }
+static volatile uint8_t g_rx_ucast_src[6];  // transmitter of the last unicast data frame for us
+/* One line per peer heard in the last 5 s: the address's last two bytes, its ch6 slots
+   (mask), how long ago it was heard; '*' marks the master we gate on (`master`), '>' the
+   sender of the last unicast data for us. */
+extern "C" size_t awdl_peers_describe(char *out, size_t cap, const uint8_t master[6]) {
+  size_t n = 0;
+  if (cap) out[0] = 0;
+  uint8_t src[6];
+  memcpy(src, (const void *)g_rx_ucast_src, 6);
+  uint32_t now = millis();
+  taskENTER_CRITICAL(&g_mux);
+  for (int i = 0; i < AWDL_PEERS && n + 40 < cap; i++) {
+    const struct AwdlPeer *p = &g_peers.row[i];
+    if (!p->used || (uint32_t)(now - p->last_ms) > 5000) continue;
+    uint16_t mask = p->have_chseq ? awdl_chanseq_mask_of(p->chseq, PROBE_CHANNEL) : 0;
+    n += snprintf(out + n, cap - n, " %c%c%02x%02x ch6 %d/16 (%04x) %ums",
+                  memcmp(p->addr, master, 6) == 0 ? '*' : ' ', memcmp(p->addr, src, 6) == 0 ? '>' : ' ',
+                  p->addr[4], p->addr[5], __builtin_popcount(mask), mask, (unsigned)(now - p->last_ms));
+  }
+  taskEXIT_CRITICAL(&g_mux);
+  n += snprintf(out + n, n < cap ? cap - n : 0, " | last ucast from %02x%02x", src[4], src[5]);
+  return n;
+}
 
