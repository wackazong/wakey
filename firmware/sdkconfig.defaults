# ── Chip ────────────────────────────────────────────────────────────────
# Tab5 ships with ESP32-P4 revision v1.3 (checked with `espflash board-info`).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# v1.x tops out at 360 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# ── Flash (partition table: partitions.csv, applied by scripts/flash.sh) ──
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ── PSRAM: 32 MB hex-mode at 200 MHz, holds the frame buffers ──────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc() takes PSRAM first; internal RAM is left to what asks for it
# (DMA buffers, FreeRTOS objects, stacks). With the default (up to 16 KiB
# internal first), Slint's small allocations filled internal RAM when the
# alarm list opened: the SD card driver found no DMA buffer (saving failed),
# std could not create a mutex (abort), and frames ran ~4x slower. A larger
# CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL did not help: malloc used it up too.
# Loads from cached PSRAM take as long as from internal RAM (6 cycles).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Bigger L2 cache and lines help the PSRAM-bound frame buffer traffic.
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ── Console on the USB-C port (USB Serial/JTAG) ────────────────────────
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Tasks ──────────────────────────────────────────────────────────────
# The Embassy executor (and Slint rendering) runs on its own 64 KiB task
# (src/runtime.rs); the main task only starts it. It is created after the
# C constructors (esp_hosted allocates in one), so it stays small.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384

# ── Display ────────────────────────────────────────────────────────────
# Keep the DPI ISR and its callbacks working while the flash cache is busy.
CONFIG_LCD_DSI_ISR_HANDLER_IN_IRAM=y

# ── Logging ────────────────────────────────────────────────────────────
# Allow DEBUG logs per tag at run time (esp_log_level_set), e.g. for the
# USB host stack. Default level stays INFO.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ── FAT ────────────────────────────────────────────────────────────────
# Long file names on the SD card (buffers on the heap).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ── Wi-Fi via the ESP32-C6 (esp_hosted over SDIO) ──────────────────────
# The Tab5 preset sets SDIO slot 1 on GPIO 8–13 (4 bit) and the C6 reset on
# GPIO15. The SD card uses slot 0; both share the SDMMC host.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# GPIO15 (SOC_EXTRF_RST) drives the C6's EN through 1 kΩ (schematic p. 2):
# low = reset, high = run, which esp_hosted calls "active high". The Tab5
# preset defaults to active low and then holds the C6 in reset for good
# (sdmmc send_op_cond 0x107). ESPHome's Tab5 config also uses active high.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# esp_hosted initialises in a C constructor, before ESP-IDF creates the
# main task: keep its pools and task stacks out of internal RAM and its
# queues short (internal RAM is tight; see src/runtime.rs).
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# Longer queues (20/40) and RX double buffering were tried for downloads:
# no faster (the C6 link gives ~1.1 MiB/s), 3 KiB less internal RAM.
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=10
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=10
CONFIG_ESP_HOSTED_SDIO_RX_DOUBLE_BUFFERING=n
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_ESP_HOSTED_MEM_MONITOR=n
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
# The C6's Wi-Fi buffers: sent to the C6 with esp_wifi_init (the slave
# uses the host's values), allocated in the C6's RAM, none on the P4.
# Espressif's P4+C6 performance profile (esp_hosted
# docs/performance_optimization.md).
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32

# HTTPS (TIDAL): mbedTLS's buffers (a 16 KiB record buffer and more per
# connection) in PSRAM; internal RAM is short (~100 KiB free in a Wi-Fi
# session). The certificate bundle (default: full) verifies the servers.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# ChaCha20-Poly1305: mbedTLS offers it first and TIDAL's CDN (Fastly)
# takes the client's order. AES-GCM cost ~60 % of core 0 at 1 MiB/s: the
# AES DMA driver syncs caches with interrupts off for each record (buffers
# in PSRAM), GHASH runs in software; software AES was slower still.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# TCP receive window: the default 5760 bytes allowed ~185 KiB/s at ~30 ms to
# TIDAL's CDN (window / round trip; a track took 2.5 min). 64 KiB, and
# mailboxes that hold a window's worth of segments (65534 / 1440 MSS = 46).
# The pbufs come from the general heap (PSRAM here).
# Window scaling (needs lwIP's memory allowed in PSRAM): 256 KiB, and
# mailboxes for 256 KiB / 1440 = 182 segments.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=3
CONFIG_LWIP_TCP_WND_DEFAULT=262144
CONFIG_LWIP_TCP_RECVMBOX_SIZE=192
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=192

# CPU time per task (`taskstats`, feature `task-stats`): FreeRTOS keeps a
# run-time counter per task (esp_timer based, cheap).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
