// The alarm clock's UI: one landscape 1280×720 window showing one page at a
// time. Pages talk to Rust through globals (`Clock`, `AlarmList`,
// `AlarmEditor`, `SoundPicker`, `NameEditor`); the view models are in
// `src/app/`.
//
// One font face only: Slint pre-renders every imported face at every pixel
// size used in this program (ASCII plus the characters of string
// literals), and the 280 px digits alone are about 2 MB of flash per face.
// Sizes in use: 30, 40, 64, 280 px (see `wakey/theme.slint`); reuse them.

import "fonts/Inter-24pt-Medium.ttf";
import { Theme } from "wakey/theme.slint";
import { Clock, ClockPage } from "wakey/clock_page.slint";
import { AlarmList, AlarmRow, AlarmListPage } from "wakey/alarm_list.slint";
import { AlarmEditor, AlarmPage } from "wakey/alarm_page.slint";
import { SoundPicker, SoundRow, SoundPage } from "wakey/sound_page.slint";
import { NameEditor, NamePage } from "wakey/name_page.slint";

export { Clock, AlarmList, AlarmRow, AlarmEditor, SoundPicker, SoundRow, NameEditor }

export component AppWindow inherits Window {
    width: 1280px;
    height: 720px;
    background: Theme.background;
    default-font-family: "Inter 24pt Medium";

    // 0 clock, 1 alarm list, 2 alarm, 3 sound, 4 name.
    in-out property <int> page: 0;

    // Never shown: makes the compiler embed glyphs that only appear in
    // strings set from Rust (dates, Wi-Fi errors, alarm names, file
    // names).
    Text { visible: false; text: "ÄÖÜäöüßéèàç…·×–„“"; font-size: 30px; }
    Text { visible: false; text: "ÄÖÜäöüßéèàç…·×–„“"; font-size: 40px; }

    if root.page == 0: ClockPage { }
    if root.page == 1: AlarmListPage { }
    if root.page == 2: AlarmPage { }
    if root.page == 3: SoundPage { }
    if root.page == 4: NamePage { }
}
