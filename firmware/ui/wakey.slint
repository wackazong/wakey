// The alarm clock's screens. Landscape 1280×720, dark: the display is the
// room's night light, so no large bright areas.
//
// Text fields that change at different rates are separate, fixed-width
// items: the once-a-second update dirties only the seconds, the big digits
// only when they change, and digit widths cannot shift the layout.
//
// One font face only: Slint pre-renders every imported face at every pixel
// size used in this file (ASCII set), and the 280 px digits alone are
// about 2 MB of flash per face.

import "fonts/Inter-24pt-Medium.ttf";

export component ClockScreen inherits Window {
    width: 1280px;
    height: 720px;
    background: #0b0e12;
    default-font-family: "Inter 24pt";

    in property <string> hours: "--";
    in property <string> minutes: "--";
    in property <string> seconds: "--";
    // "Montag, 9. November 2026"
    in property <string> date: "";
    // Next alarm, or why there is none.
    in property <string> alarm: "";
    in property <bool> speaker-connected: false;

    // Time: HH:MM large, seconds small to the right, on the same baseline.
    HorizontalLayout {
        x: 0;
        y: 150px;
        width: parent.width;
        height: 360px;
        alignment: center;
        spacing: 0;

        Text { text: root.hours; width: 380px; font-size: 280px; font-weight: 500; color: #f0f4f8; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: ":"; width: 90px; font-size: 280px; font-weight: 500; color: #4a5560; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: root.minutes; width: 380px; font-size: 280px; font-weight: 500; color: #f0f4f8; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            width: 120px;
            Text {
                x: 10px;
                y: 212px;
                width: 110px;
                height: 72px;
                text: root.seconds;
                font-size: 64px;
                font-weight: 500;
                color: #66727f;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    Text {
        x: 0;
        y: 510px;
        width: parent.width;
        height: 56px;
        text: root.date;
        font-size: 40px;
        color: #8899aa;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Bottom bar: alarm on the left, speaker state on the right.
    Text {
        x: 40px;
        y: parent.height - 70px;
        width: 800px;
        height: 44px;
        text: root.alarm;
        font-size: 30px;
        color: #66727f;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 440px;
        y: parent.height - 70px;
        width: 400px;
        height: 44px;
        text: root.speaker-connected ? "Lautsprecher verbunden" : "Kein Lautsprecher";
        font-size: 24px;
        color: root.speaker-connected ? #4f9a6c : #4a5560;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
