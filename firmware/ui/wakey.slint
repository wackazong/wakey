// The alarm clock's UI: one landscape 1280×720 window showing one page at a
// time. Pages talk to Rust through globals (`Clock`, `AlarmEditor`); the
// view models are in `src/app/`.
//
// One font face only: Slint pre-renders every imported face at every pixel
// size used in this program (ASCII plus the characters of string
// literals), and the 280 px digits alone are about 2 MB of flash per face.
// Sizes in use: 24, 30, 40, 64, 140, 280 px; reuse them.

import "fonts/Inter-24pt-Medium.ttf";
import { Theme } from "wakey/theme.slint";
import { Clock, ClockPage } from "wakey/clock_page.slint";
import { AlarmEditor, AlarmPage } from "wakey/alarm_page.slint";

export { Clock, AlarmEditor }

export component AppWindow inherits Window {
    width: 1280px;
    height: 720px;
    background: Theme.background;
    default-font-family: "Inter 24pt";

    // 0 clock, 1 alarm settings.
    in-out property <int> page: 0;

    // Never shown: makes the compiler embed glyphs that only appear in
    // strings set from Rust (dates, Wi-Fi errors, alarm texts).
    Text { visible: false; text: "ÄÖÜäöüß…·–"; font-size: 24px; }
    Text { visible: false; text: "ÄÖÜäöüß·×–"; font-size: 30px; }
    Text { visible: false; text: "ÄÖÜäöüß"; font-size: 40px; }

    if root.page == 0: ClockPage { }
    if root.page == 1: AlarmPage { }
}
