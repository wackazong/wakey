// The alarm clock's UI: one landscape 1280×720 window showing one page at a
// time. Pages talk to Rust through globals (`Clock`, `AlarmList`,
// `AlarmEditor`, `SoundPicker`, `NameEditor`); the view models are in
// `src/app/`.
//
// One font face only: Slint pre-renders every imported face at every pixel
// size used in this program (ASCII plus the characters of string
// literals), and the 280 px digits alone are about 2 MB of flash per face.
// Sizes in use: 30, 40, 64, 280 px (see `wakey/theme.slint`); reuse them.

import "fonts/Inter-24pt-Medium.ttf";
import { Theme } from "wakey/theme.slint";
import { Clock, ClockPage } from "wakey/clock_page.slint";
import { AlarmList, AlarmListLayout, AlarmRow, AlarmListPage, ListRowPage } from "wakey/alarm_list.slint";
import { AlarmEditor, AlarmPage } from "wakey/alarm_page.slint";
import { SoundPicker, SoundRow, SoundPage, SoundListLayout, SoundRowItem } from "wakey/sound_page.slint";
import { NameEditor, NamePage } from "wakey/name_page.slint";

export { Theme, Clock, AlarmList, AlarmListLayout, AlarmRow, AlarmEditor, SoundPicker, SoundRow, SoundListLayout, NameEditor }

export component AppWindow inherits Window {
    width: 1280px;
    height: 720px;
    background: Theme.background;
    default-font-family: "Inter 24pt Medium";

    // 0 clock, 1 alarm list, 2 alarm, 3 sound, 4 name; 5 one alarm list
    // row (`list-row`), 7 one sound list row (`sound-row`), shown offscreen
    // for the list layers.
    in-out property <int> page: 0;
    // Flipped to repaint the whole window (the pixel dimming changed:
    // `ui::dim`).
    in property <bool> repaint-all;
    in property <AlarmRow> list-row;
    in property <length> list-row-dx;
    in property <bool> list-row-highlighted;
    in property <bool> list-row-underlay;
    in property <SoundRow> sound-row;
    in property <int> sound-row-tab;
    in property <int> sound-row-ms;
    // Page 6: `config.json` cannot be read (the parser's message).
    in property <string> error-text;
    // Debug overlay (cargo feature `debug-overlay`): shown when not empty.
    in property <string> debug-text;

    // Never shown: makes the compiler embed glyphs that only appear in
    // strings set from Rust (dates, Wi-Fi errors, alarm names, file
    // names).
    // Also typographic quotes and accented letters: titles from TIDAL
    // ("Can’t") showed a blob for the right single quotation mark.
    Text { visible: false; text: "ÄÖÜäöüßéèàç…·×–„“’‘‚”—«»‹›¡¿ÀÁÂÃÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕØÙÚÛÝàáâãåæêëìíîïñòóôõøùúûýÿœŒšŠžŽłŁ"; font-size: 30px; }
    Text { visible: false; text: "ÄÖÜäöüßéèàç…·×–„“’‘‚”—«»‹›¡¿ÀÁÂÃÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÕØÙÚÛÝàáâãåæêëìíîïñòóôõøùúûýÿœŒšŠžŽłŁ"; font-size: 40px; }

    if root.page == 0: ClockPage { }
    if root.page == 1: AlarmListPage { }
    if root.page == 2: AlarmPage { }
    if root.page == 3: SoundPage { }
    if root.page == 4: NamePage { }
    // Never visible: a change of its colour marks the whole window dirty.
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.repaint-all ? #00000000 : #01010100;
    }
    if root.debug-text != "" && root.page != 5: Rectangle {
        x: 8px;
        y: 8px;
        width: debug.preferred-width + 16px;
        height: debug.preferred-height + 8px;
        background: #000000b0;
        border-radius: 6px;
        debug := Text {
            x: 8px;
            y: 4px;
            text: root.debug-text;
            color: white;
            font-size: 20px;
        }
    }
    // At the window's origin (an element without x/y is centred).
    if root.page == 6: Rectangle {
        background: Theme.background;
        Text {
            x: 80px;
            y: 120px;
            width: parent.width - 160px;
            text: "config.json ist fehlerhaft";
            font-size: 40px;
            color: Theme.text;
        }
        Text {
            x: 80px;
            y: 220px;
            width: parent.width - 160px;
            text: root.error-text;
            font-size: 30px;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        Text {
            x: 80px;
            y: 520px;
            width: parent.width - 160px;
            text: "Die Datei auf der Speicherkarte korrigieren und den Wecker neu starten. Bis dahin läuft er nicht, auch kein Alarm.";
            font-size: 30px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
    if root.page == 5: ListRowPage {
        x: 0;
        y: 0;
        alarm: root.list-row;
        dx: root.list-row-dx;
        highlighted: root.list-row-highlighted;
        underlay: root.list-row-underlay;
    }
    // The offscreen sound row's second line scrolls (`Marquee`, same font
    // and box): only then does the row look different at another time.
    sound-row-sub := Text {
        visible: false;
        text: root.sound-row.sub;
        font-size: 30px;
    }
    out property <bool> sound-row-scrolls: root.sound-row.sub != "" && root.sound-row.kind != 4
        && sound-row-sub.preferred-width > SoundListLayout.width - SoundListLayout.text-x(root.sound-row.kind, root.sound-row-tab) - 96px;
    if root.page == 7: SoundRowItem {
        x: 0;
        y: 0;
        item: root.sound-row;
        tab: root.sound-row-tab;
        marquee-ms: root.sound-row-ms;
        opaque: true;
    }
}
