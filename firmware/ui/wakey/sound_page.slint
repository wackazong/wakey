// The sound of the alarm being edited: source (Datei / TIDAL), the list of
// sounds, volume, fade-in and a preview. Tapping a row chooses it; the
// choice goes back to the alarm page with "‹ Alarm" and is saved with it.
//
// ┌ ‹ Alarm ──────────────────────────────────────────────┐
// │ (Datei | TIDAL)           │ Lautstärke                │
// │ Eingebauter Ton           │ ───────●──────            │
// │ ⤮ Zufällig                │ Einblenden                │
// │ Morgenlicht            ✓  │ (aus)(10 s)(30 s)(60 s)   │
// │ Vogelstimmen              │ [▶ Probehören]            │
// └───────────────────────────────────────────────────────┘

import { Theme, Button, BackButton, Icon, Marquee, Pills, Slider } from "theme.slint";

export struct SoundRow {
    title: string,
    // Second line (artist, "Piepen"), or empty.
    sub: string,
    selected: bool,
    // 0 built-in tone, 1 random, 2 file, 3 TIDAL track (with `cover`).
    kind: int,
    // A TIDAL track's album cover (88 × 88); empty while not on the card.
    cover: image,
    // A download under way: how far (0–1), drawn as a bar under the row;
    // below 0: none.
    progress: float,
    // A TIDAL track whose download failed: greyed out, the failed icon at
    // the end instead of the check, cannot be picked.
    failed: bool,
}

// Set from Rust (`app/sound_page.rs`).
export global SoundPicker {
    // 0 Datei, 1 TIDAL.
    in property <int> tab;
    in property <[SoundRow]> rows;
    // A note below the rows (no TIDAL yet, no sound files), or empty.
    in property <string> empty;
    in-out property <int> volume;
    // Index into 0, 10, 30, 60 s.
    in-out property <int> fade;
    in property <bool> previewing;
    // TIDAL tab: 0 the rows (or `empty`), 1 a login code to confirm.
    in property <int> tidal-view;
    in property <image> tidal-qr;
    in property <string> tidal-code;

    callback back();
    callback select-tab(int);
    callback select(int);
    callback volume-changed(int);
    callback fade-changed(int);
    callback preview();
    // The TIDAL state changed: fill the tab again.
    callback refresh();
    // Twice a second while the TIDAL tab is open: the progress bar.
    callback tick();
}

// As high as a Button (88 px): smaller targets were missed. The active
// item's background fills the whole height and slides to a new choice.
component Segment inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    callback chosen(int);
    height: 88px;
    border-radius: 44px;
    // Pressed: the whole bar lights up (no gaps at the bends next to the
    // active item).
    background: ta.pressed ? Theme.surface-pressed : Theme.surface;
    property <length> item-width: root.width / Math.max(1, root.items.length);
    ta := TouchArea {
        clicked => {
            root.chosen(Math.clamp(Math.floor(self.mouse-x / root.item-width), 0, root.items.length - 1));
        }
    }
    Rectangle {
        x: root.selected * root.item-width;
        width: root.item-width;
        border-radius: 44px;
        background: Theme.accent-dark;
        animate x { duration: 180ms; easing: ease-out; }
    }
    for item[i] in root.items: Text {
        x: i * root.item-width;
        width: root.item-width;
        text: item;
        font-size: 40px;
        color: i == root.selected ? Theme.text : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SoundPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    TouchArea { }

    BackButton {
        x: 24px;
        y: 20px;
        width: 240px;
        text: "Alarm";
        clicked => { SoundPicker.back(); }
    }

    // The list takes what the settings card leaves: the card is as wide as
    // the four fade-in pills (4 × 104 + 3 × 12) plus its margins.
    property <length> card-width: 4 * 104px + 3 * 12px + 2 * 32px;
    property <length> list-width: self.width - 40px - 40px - 24px - self.card-width;

    Segment {
        x: 40px;
        y: 132px;
        width: root.list-width;
        items: ["Datei", "TIDAL"];
        selected: SoundPicker.tab;
        chosen(i) => { SoundPicker.select-tab(i); }
    }

    // Below the tabs (132 + 88 + 24), down to the settings card's bottom.
    Rectangle {
        x: 40px;
        y: 244px;
        width: root.list-width;
        height: 444px;
        border-radius: 28px;
        clip: true;
        background: Theme.card;

        // Below the rows, in the space left.
        if SoundPicker.empty != "": Text {
            x: 40px;
            y: SoundPicker.rows.length * 112px;
            width: parent.width - 80px;
            height: parent.height - self.y;
            text: SoundPicker.empty;
            font-size: 30px;
            color: Theme.text-faint;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // The login: QR code of the link, and the code.
        if SoundPicker.tab == 1 && SoundPicker.tidal-view == 1: Rectangle {
            Rectangle {
                x: 32px;
                y: (parent.height - self.height) / 2;
                width: 320px;
                height: 320px;
                border-radius: 16px;
                background: white;
                Image {
                    source: SoundPicker.tidal-qr;
                    width: 300px;
                    height: 300px;
                }
            }
            Text {
                x: 384px;
                y: 64px;
                width: parent.width - self.x - 32px;
                text: "Mit dem Handy scannen und bei TIDAL bestätigen.";
                font-size: 30px;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                x: 384px;
                y: 260px;
                width: parent.width - self.x - 32px;
                text: "Code: " + SoundPicker.tidal-code;
                font-size: 40px;
                color: Theme.text-dim;
            }
        }
        Flickable {
            content-height: SoundPicker.rows.length * 112px;
            for row[i] in SoundPicker.rows: Rectangle {
                y: i * 112px;
                height: 112px;
                background: ta.pressed && !row.failed ? Theme.surface : row.selected ? Theme.selected : transparent;
                if row.progress >= 0: Rectangle {
                    x: 0;
                    width: parent.width * clamp(row.progress, 0, 1);
                    height: parent.height;
                    background: Theme.accent-dark;
                }
                // On the TIDAL tab „Zufällig“'s icon sits in the covers'
                // column, so the texts line up.
                if row.kind == 1: Icon {
                    kind: 5;
                    x: SoundPicker.tab == 1 ? 46px : 32px;
                    y: 34px;
                    width: 44px;
                    height: 44px;
                    color: Theme.accent;
                }
                if row.kind == 3: Rectangle {
                    x: 24px;
                    y: 12px;
                    width: 88px;
                    height: 88px;
                    background: Theme.surface;
                    opacity: row.failed ? 0.4 : 1;
                    Image {
                        width: 88px;
                        height: 88px;
                        source: row.cover;
                    }
                }
                Text {
                    x: row.kind == 3 || (row.kind == 1 && SoundPicker.tab == 1) ? 132px : row.kind == 1 ? 96px : 32px;
                    y: row.sub != "" ? 10px : 0;
                    height: row.sub != "" ? 54px : 112px;
                    width: parent.width - self.x - 96px;
                    text: row.title;
                    font-size: 40px;
                    color: row.failed ? Theme.text-faint : Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Scrolls if too long (artist, „Nicht mehr in der Playlist“).
                if row.sub != "": Marquee {
                    x: row.kind == 3 || (row.kind == 1 && SoundPicker.tab == 1) ? 132px : row.kind == 1 ? 96px : 32px;
                    y: 62px;
                    height: 40px;
                    width: parent.width - self.x - 96px;
                    text: row.sub;
                    font-size: 30px;
                    text-color: row.failed ? Theme.text-faint : Theme.text-dim;
                }
                if row.selected && !row.failed: Icon {
                    kind: 2;
                    x: parent.width - 90px;
                    y: 24px;
                    width: 64px;
                    height: 64px;
                    weight: 4.5px;
                    color: Theme.accent;
                }
                // Failed: a white cross on a red circle.
                if row.failed: Rectangle {
                    x: parent.width - 80px;
                    y: 34px;
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: Theme.error;
                    Icon {
                        kind: 13;
                        x: 7px;
                        y: 7px;
                        width: 30px;
                        height: 30px;
                        color: Theme.text;
                    }
                }
                ta := TouchArea {
                    clicked => { SoundPicker.select(i); }
                }
            }
        }
    }

    Rectangle {
        x: root.width - 24px - root.card-width;
        y: 132px;
        width: root.card-width;
        height: 556px;
        border-radius: 28px;
        background: Theme.card;

        Text {
            x: 32px;
            y: 24px;
            height: 48px;
            text: "Lautstärke";
            font-size: 40px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Slider {
            x: 32px;
            y: 92px;
            width: parent.width - 64px;
            value <=> SoundPicker.volume;
            // Never silent (`wakey_core::alarm::VOLUME_MIN`).
            minimum: 1;
            changed-by-user(v) => { SoundPicker.volume-changed(v); }
        }
        Text {
            x: 32px;
            y: 216px;
            height: 48px;
            text: "Einblenden";
            font-size: 40px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Pills {
            x: 32px;
            y: 280px;
            width: parent.width - 64px;
            items: ["aus", "10 s", "30 s", "60 s"];
            selected: SoundPicker.fade;
            chosen(i) => {
                SoundPicker.fade = i;
                SoundPicker.fade-changed(i);
            }
        }
        Button {
            x: 32px;
            y: 420px;
            width: 320px;
            icon: SoundPicker.previewing ? 4 : 3;
            text: SoundPicker.previewing ? "Stopp" : "Probehören";
            clicked => { SoundPicker.preview(); }
        }
    }
}
