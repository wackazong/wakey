// The sound of the alarm being edited: source (Datei / TIDAL), the list of
// sounds, volume, fade-in and a preview. Tapping a row chooses it; the
// choice goes back to the alarm page with "‹ Alarm" and is saved with it.
//
// ┌ ‹ Alarm ──────────────────────────────────────────────┐
// │ (Datei | TIDAL)           │ Lautstärke                │
// │ ⤮ Zufällig                │ ───────●──────            │
// │ Morgenlicht            ✓  │ Einblenden                │
// │ Vogelstimmen              │ (aus)(10 s)(30 s)(60 s)   │
// │ AirDrop bereit für …      │ [▶ Probehören]            │
// └───────────────────────────────────────────────────────┘

import { Theme, Button, ButtonKind, BackButton, Icon, IconKind, Marquee, Pills, Slider } from "theme.slint";

export enum SoundRowKind {
    // „Zufällig“: another sound of the tab every day.
    random,
    file,
    // With `cover`.
    tidal-track,
    // A note at the end of the list (AirDrop's state); not a choice.
    airdrop-note,
    // A file arriving by AirDrop (with `progress`); not a choice.
    airdrop-file,
}

export enum SoundTab { files, tidal }

// What the TIDAL tab shows.
export enum TidalView {
    // The tracks, or a note on why there are none.
    list,
    // A login code to confirm.
    login,
}

export struct SoundRow {
    title: string,
    // Second line (artist, „wechselt jeden Tag“), or empty.
    sub: string,
    selected: bool,
    kind: SoundRowKind,
    // A TIDAL track's album cover (88 × 88); empty while not on the card.
    cover: image,
    // A download under way: how far (0–1), drawn as a bar under the row;
    // below 0: none.
    progress: float,
    // A TIDAL track whose download failed: greyed out, the failed icon at
    // the end instead of the check, cannot be picked.
    failed: bool,
}

// Set from Rust (`src/app/sound_page/`).
export global SoundPicker {
    // The tab bar's choice.
    in property <SoundTab> tab;
    // The list shown: follows `tab` once the tab bar's highlight has
    // arrived (the list's repaint does not stall the slide).
    in property <SoundTab> shown-tab;
    // Both lists, filled when the page opens.
    in property <[SoundRow]> rows;
    in property <[SoundRow]> tidal-rows;
    // A note below the TIDAL tab's rows (why there are none), or empty.
    // The Files tab's list ends with AirDrop's note, a row.
    in property <string> tidal-empty;
    // Scroll positions of both lists (content y at the top), set by the
    // list layer when a scroll ends; it shows the list while it moves.
    in property <length> files-scroll;
    in property <length> tidal-scroll;
    // The list layer moves the list (the page does not draw it then).
    in property <bool> layer-active;
    // The scrolling texts' clock (ms, wraps hourly): advanced every 25 ms
    // while the page draws the list (`SoundPage`), paused while the list
    // layer moves it.
    in-out property <int> marquee-ms;
    // Caps over the list card's rounded corners (Slint clips rectangles
    // only): page background outside the rounding (from Rust, the list
    // layer blends the same).
    in property <image> corner-tl;
    in property <image> corner-tr;
    in property <image> corner-bl;
    in property <image> corner-br;
    in-out property <int> volume;
    // Index into 0, 10, 30, 60 s.
    in-out property <int> fade;
    in property <bool> previewing;
    in property <TidalView> tidal-view;
    in property <image> tidal-qr;
    in property <string> tidal-code;

    callback back();
    // Saves the whole alarm and shows the list (as on the alarm page).
    callback save();
    // Sichern possible: a change, at least one day (set from Rust).
    in property <bool> can-save;
    callback select-tab(SoundTab);
    callback select(int);
    callback volume-changed(int);
    callback fade-changed(int);
    callback preview();
    // The TIDAL state changed: fill the tab again.
    callback refresh();
    // Twice a second while the TIDAL tab is open: the progress bar.
    callback tick();
    // Four times a second while the Files tab is open: AirDrop's state.
    callback airdrop-tick();
}

// As high as a Button (88 px): smaller targets get missed. The active
// item's background fills the whole height and slides to a new choice.
component Segment inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    callback chosen(int);
    height: 88px;
    border-radius: 44px;
    // Pressed: the whole bar lights up (no gaps at the bends next to the
    // active item).
    background: ta.pressed ? Theme.surface-pressed : Theme.surface;
    property <length> item-width: root.width / Math.max(1, root.items.length);
    // The highlight follows a finger that moved more than 12 px; released,
    // it snaps to the nearer item. A tap picks the item under it.
    property <bool> dragging;
    property <length> drag-x: Math.clamp(
        root.selected * root.item-width + ta.mouse-x - ta.pressed-x,
        0px,
        root.width - root.item-width);
    function choose(i: int) {
        if (i != root.selected) {
            root.chosen(i);
        }
    }
    ta := TouchArea {
        moved => {
            if (Math.abs(self.mouse-x - self.pressed-x) > 12px) {
                root.dragging = true;
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.dragging = false;
                    root.choose(Math.round(root.drag-x / root.item-width));
                } else {
                    root.choose(Math.clamp(Math.floor(self.mouse-x / root.item-width), 0, root.items.length - 1));
                }
            } else if (e.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }
    }
    Rectangle {
        x: root.dragging ? root.drag-x : root.selected * root.item-width;
        width: root.item-width;
        border-radius: 44px;
        background: Theme.accent-dark;
        // Straight under the finger while dragged.
        animate x { duration: root.dragging ? 0ms : 180ms; easing: ease-out; }
    }
    for item[i] in root.items: Text {
        x: i * root.item-width;
        width: root.item-width;
        text: item;
        font-size: 40px;
        color: i == root.selected ? Theme.text : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Where the sound list is (landscape px), its rows' pitch and its card's
// corners: the page and the list layer (`src/app/sound_page/rows.rs`) both
// use it.
export global SoundListLayout {
    out property <length> x: 40px;
    out property <length> y: 244px;
    // The settings card right of the list: as wide as the four fade-in
    // pills (4 × 104 + 3 × 12) plus its margins.
    out property <length> settings-width: 4 * 104px + 3 * 12px + 2 * 32px;
    // What the settings card leaves.
    out property <length> width: 1280px - 40px - 40px - 24px - self.settings-width;
    out property <length> height: 444px;
    out property <length> pitch: 112px;
    out property <length> corner-radius: 28px;
    // How far a finger moves before the touch counts as a scroll.
    out property <length> slop: 12px;
    // Where a row's texts start (`SoundRowItem`): after the cover, or the
    // random icon (on the TIDAL tab in the covers' column).
    public pure function text-x(kind: SoundRowKind, tab: SoundTab) -> length {
        kind == SoundRowKind.tidal-track || (kind == SoundRowKind.random && tab == SoundTab.tidal) ? 132px
            : kind == SoundRowKind.random ? 96px : 32px
    }
    // A row that can be picked (not one of AirDrop's).
    public pure function is-choice(kind: SoundRowKind) -> bool {
        kind != SoundRowKind.airdrop-note && kind != SoundRowKind.airdrop-file
    }
}

// One row of the sound list, as the page draws it and as the list layer
// renders it offscreen (the same pixels).
export component SoundRowItem inherits Rectangle {
    in property <SoundRow> item;
    // On the TIDAL tab „Zufällig“'s icon is in the covers' column.
    in property <SoundTab> tab;
    // The clock of the scrolling second line (`Marquee.time-ms`).
    in property <int> marquee-ms;
    // Offscreen (the list layer's copy) the row brings the card's colour;
    // on the page the card shows through (its rounded corners stay).
    in property <bool> opaque;
    callback clicked();
    width: SoundListLayout.width;
    height: SoundListLayout.pitch;
    background: ta.pressed && !root.item.failed && SoundListLayout.is-choice(root.item.kind) ? Theme.surface
        : root.item.selected ? Theme.selected
        : root.opaque ? Theme.card : transparent;

    // The AirDrop note: centred, faint, as the list's other notes.
    if root.item.kind == SoundRowKind.airdrop-note: Text {
        x: 40px;
        width: parent.width - 80px;
        height: parent.height;
        text: root.item.title;
        font-size: 30px;
        color: Theme.text-faint;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.item.progress >= 0: Rectangle {
        x: 0;
        width: parent.width * clamp(root.item.progress, 0, 1);
        height: parent.height;
        background: Theme.accent-dark;
    }
    // On the TIDAL tab „Zufällig“'s icon sits in the covers'
    // column, so the texts line up.
    if root.item.kind == SoundRowKind.random: Icon {
        kind: IconKind.shuffle;
        x: root.tab == SoundTab.tidal ? 46px : 32px;
        y: 34px;
        width: 44px;
        height: 44px;
        color: Theme.accent;
    }
    if root.item.kind == SoundRowKind.tidal-track: Rectangle {
        x: 24px;
        y: 12px;
        width: 88px;
        height: 88px;
        background: Theme.surface;
        opacity: root.item.failed ? 0.4 : 1;
        Image {
            width: 88px;
            height: 88px;
            source: root.item.cover;
        }
    }
    if root.item.kind != SoundRowKind.airdrop-note: Text {
        x: SoundListLayout.text-x(root.item.kind, root.tab);
        y: root.item.sub != "" ? 10px : 0;
        height: root.item.sub != "" ? 54px : 112px;
        width: parent.width - self.x - 96px;
        text: root.item.title;
        font-size: 40px;
        color: root.item.failed ? Theme.text-faint : Theme.text;
        overflow: elide;
        vertical-alignment: center;
    }
    // Scrolls if too long (artist, „Nicht mehr in der Playlist“).
    if root.item.sub != "" && root.item.kind != SoundRowKind.airdrop-note: Marquee {
        x: SoundListLayout.text-x(root.item.kind, root.tab);
        y: 62px;
        height: 40px;
        width: parent.width - self.x - 96px;
        text: root.item.sub;
        font-size: 30px;
        text-color: root.item.failed ? Theme.text-faint : Theme.text-dim;
        time-ms: root.marquee-ms;
    }
    if root.item.selected && !root.item.failed: Icon {
        kind: IconKind.check;
        x: parent.width - 90px;
        y: 24px;
        width: 64px;
        height: 64px;
        weight: 4.5px;
        color: Theme.accent;
    }
    // Failed: a white cross on a red circle.
    if root.item.failed: Rectangle {
        x: parent.width - 80px;
        y: 34px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Theme.error;
        Icon {
            kind: IconKind.cross;
            x: 7px;
            y: 7px;
            width: 30px;
            height: 30px;
            color: Theme.text;
        }
    }
    ta := TouchArea {
        enabled: SoundListLayout.is-choice(root.item.kind);
        clicked => { root.clicked(); }
    }
}

// One tab's list: rows at the scroll position `scroll` (the list layer
// moves it), and a note below them.
component SoundList inherits Rectangle {
    in property <[SoundRow]> rows;
    in property <string> empty;
    in property <SoundTab> tab;
    in property <length> scroll;
    callback select(int);
    // Below the rows, in the space left.
    if root.empty != "": Text {
        x: 40px;
        y: root.rows.length * SoundListLayout.pitch - root.scroll;
        width: parent.width - 80px;
        height: Math.max(0px, parent.height - self.y);
        text: root.empty;
        font-size: 30px;
        color: Theme.text-faint;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for row[i] in root.rows: SoundRowItem {
        x: 0;
        y: i * SoundListLayout.pitch - root.scroll;
        item: row;
        tab: root.tab;
        marquee-ms: SoundPicker.marquee-ms;
        clicked => { root.select(i); }
    }
}

export component SoundPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    TouchArea { }
    // The scrolling texts' clock: a timer that adds the time since its last
    // tick. A binding on `animation-tick()` would animate as well (the render
    // loop draws for it); the timer can be paused while the list layer moves
    // the list (`running`), and after such a pause it adds one step, so the
    // texts go on from where they stood.
    property <float> marquee-last;
    property <float> marquee-dt;
    Timer {
        interval: 25ms;
        running: !SoundPicker.layer-active;
        triggered => {
            root.marquee-dt = animation-tick() / 1ms - root.marquee-last;
            root.marquee-last = animation-tick() / 1ms;
            SoundPicker.marquee-ms = Math.mod(
                SoundPicker.marquee-ms + Math.round(root.marquee-dt > 0 && root.marquee-dt < 100 ? root.marquee-dt : 25),
                3600000);
        }
    }

    BackButton {
        x: 24px;
        y: 20px;
        width: 240px;
        text: "Alarm";
        clicked => { SoundPicker.back(); }
    }
    Button {
        x: parent.width - 264px;
        y: 20px;
        width: 240px;
        kind: ButtonKind.primary;
        text: "Sichern";
        on-press: true;
        enabled: SoundPicker.can-save;
        clicked => { SoundPicker.save(); }
    }

    // The list card's corner radius.
    property <length> r: SoundListLayout.corner-radius;

    Segment {
        x: SoundListLayout.x;
        y: 132px;
        width: SoundListLayout.width;
        items: ["Datei", "TIDAL"];
        selected: SoundPicker.tab == SoundTab.files ? 0 : 1;
        chosen(i) => { SoundPicker.select-tab(i == 0 ? SoundTab.files : SoundTab.tidal); }
    }

    // Below the tabs (132 + 88 + 24), down to the settings card's bottom.
    Rectangle {
        x: SoundListLayout.x;
        y: SoundListLayout.y;
        width: SoundListLayout.width;
        height: SoundListLayout.height;
        border-radius: SoundListLayout.corner-radius;
        clip: true;
        background: Theme.card;

        SoundList {
            visible: SoundPicker.shown-tab == SoundTab.files;
            rows: SoundPicker.rows;
            tab: SoundTab.files;
            scroll: SoundPicker.files-scroll;
            select(i) => { SoundPicker.select(i); }
        }
        SoundList {
            visible: SoundPicker.shown-tab == SoundTab.tidal && SoundPicker.tidal-view == TidalView.list;
            rows: SoundPicker.tidal-rows;
            empty: SoundPicker.tidal-empty;
            tab: SoundTab.tidal;
            scroll: SoundPicker.tidal-scroll;
            select(i) => { SoundPicker.select(i); }
        }
        // The login: QR code of the link, and the code.
        if SoundPicker.shown-tab == SoundTab.tidal && SoundPicker.tidal-view == TidalView.login: Rectangle {
            Rectangle {
                x: 32px;
                y: (parent.height - self.height) / 2;
                width: 320px;
                height: 320px;
                border-radius: 16px;
                background: white;
                Image {
                    source: SoundPicker.tidal-qr;
                    width: 300px;
                    height: 300px;
                }
            }
            Text {
                x: 384px;
                y: 64px;
                width: parent.width - self.x - 32px;
                text: "Mit dem Handy scannen und bei TIDAL bestätigen.";
                font-size: 30px;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                x: 384px;
                y: 260px;
                width: parent.width - self.x - 32px;
                text: "Code: " + SoundPicker.tidal-code;
                font-size: 40px;
                color: Theme.text-dim;
            }
        }
        // Over everything in the card: its rounded corners.
        Image { x: 0; y: 0; width: root.r; height: root.r; source: SoundPicker.corner-tl; }
        Image { x: parent.width - root.r; y: 0; width: root.r; height: root.r; source: SoundPicker.corner-tr; }
        Image { x: 0; y: parent.height - root.r; width: root.r; height: root.r; source: SoundPicker.corner-bl; }
        Image { x: parent.width - root.r; y: parent.height - root.r; width: root.r; height: root.r; source: SoundPicker.corner-br; }
    }

    Rectangle {
        x: root.width - 24px - self.width;
        y: 132px;
        width: SoundListLayout.settings-width;
        height: 556px;
        border-radius: 28px;
        background: Theme.card;

        Text {
            x: 32px;
            y: 24px;
            height: 48px;
            text: "Lautstärke";
            font-size: 40px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Slider {
            x: 32px;
            y: 92px;
            width: parent.width - 64px;
            value <=> SoundPicker.volume;
            // Never silent (`wakey_core::alarm::VOLUME_MIN`).
            minimum: 1;
            changed-by-user(v) => { SoundPicker.volume-changed(v); }
        }
        Text {
            x: 32px;
            y: 216px;
            height: 48px;
            text: "Einblenden";
            font-size: 40px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Pills {
            x: 32px;
            y: 280px;
            width: parent.width - 64px;
            items: ["aus", "10 s", "30 s", "60 s"];
            selected: SoundPicker.fade;
            chosen(i) => {
                SoundPicker.fade = i;
                SoundPicker.fade-changed(i);
            }
        }
        Button {
            x: 32px;
            y: 420px;
            width: 320px;
            icon: SoundPicker.previewing ? IconKind.stop : IconKind.play;
            text: SoundPicker.previewing ? "Stopp" : "Probehören";
            clicked => { SoundPicker.preview(); }
        }
    }
}
