// The alarms, one row each, sorted by time. The one that rings next has
// its time in amber. Tap a row to edit it, its switch to turn it on or off,
// swipe it left past two thirds of the width to delete it (less springs
// back). "+ New" adds one.
//
// ┌ ‹ Clock ────────────────────────────────────── + New ┐
// │ 06:30  Work                                    (  ●) │
// │        Mo Tu We Th Fr Sa Su                          │
// │ 07:15  Mo Tu We Th Fr Sa Su                    (  ●) │
// └──────────────────────────────────────────────────────┘
//
// Motion is the firmware's list layer (`src/ui/list_layer/`): it sees
// every touch first and takes a touch over once it moves more than `slop`
// (this page then gets a cancel). Mostly vertical: it scrolls the list;
// mostly sideways on a row: it swipes that row. Either way it copies
// pre-rendered pictures (`ListRowPage`) by DMA, and when the motion ends
// it sets `AlarmList.scroll` (or deletes the swiped row) and this page
// draws the list again, the same pixels. This page handles what is left on
// the still list: taps (open, switch) and the highlight of a held row.
//
// The rows only draw the alarms; none of them depends on the touch state,
// so a press does not repaint the list. One more row, the "active" one, is
// drawn over the row being held, with the same alarm plus highlight, and
// only it repaints.

import { Lang } from "lang.slint";
import { Theme, Button, ButtonKind, BackButton, IconKind, Switch } from "theme.slint";

// What the finger on the still list is doing (scrolls and swipes are the
// layer's).
enum Gesture {
    // Down, not moved far enough to tell: a tap on release.
    undecided,
    // The touch moved without the layer taking it (a list that fits the
    // view, no row under the finger): nothing happens on release.
    ignore,
}

// Where the list is and its rows' shape, read by the list layer too
// (`src/app/alarm_list.rs`).
export global AlarmListLayout {
    out property <length> x: 40px;
    out property <length> y: 132px;
    out property <length> width: 1200px;
    out property <length> height: 588px;
    // Row height, the space below each row, and both together.
    out property <length> row-height: 150px;
    out property <length> gap: 12px;
    out property <length> pitch: self.row-height + self.gap;
    out property <length> row-radius: 28px;
    // How far a finger moves before the touch counts as a scroll or a
    // swipe.
    out property <length> slop: 12px;
}

export struct AlarmRow {
    id: int,
    // "06:30"
    time: string,
    // Empty: the days take its place.
    name: string,
    // Weekdays as bits: Monday = 1, Tuesday = 2, … Sunday = 64. (A plain
    // value, so Rust can compare rows; an array model compares by
    // identity.)
    days: int,
    enabled: bool,
    // Rings next (amber time).
    next: bool,
}

// Set from Rust (`src/app/alarm_list.rs`).
export global AlarmList {
    in property <[AlarmRow]> rows;
    // How far the still list is scrolled (0 = top); set by the list layer
    // when a scroll ends.
    in property <length> scroll;
    // The list layer is showing the list (scrolling, or a row being
    // swiped): no touch feedback here.
    in property <bool> layer-active;
    // A switch or delete that could not be saved (empty: none), shown in
    // the header until the next change or the page is opened again.
    in property <string> error;
    callback back();
    callback add();
    callback open(int);
    callback toggle(int, bool);
    callback delete(int);
}

// One alarm. `dx`, `underlay` are for the list layer's swipe pictures,
// `highlighted` touch feedback (the active row and those pictures).
component Row inherits Rectangle {
    in property <AlarmRow> alarm;
    // Horizontal offset of the row content (≤ 0: swiped left).
    in property <length> dx;
    // The delete button's red behind the content even at `dx` 0 (the list
    // layer's picture of a swiped row: its corners show that red).
    in property <bool> underlay;
    // Touched or being swiped.
    in property <bool> highlighted;
    // Changes animate (false: shown at once, see `ListRowPage`).
    in property <bool> animated: true;
    // The switch slides on a toggle. Off for a row that shows one alarm
    // after the other (the active row): it would slide from the previous
    // alarm's state.
    in property <bool> switch-animated: true;

    pure function day-on(i: int) -> bool {
        return Math.mod(Math.floor(root.alarm.days / Math.pow(2, i)), 2) == 1;
    }

    height: AlarmListLayout.row-height;
    // No `clip` needed: the list area clips the sliding content.
    border-radius: AlarmListLayout.row-radius;
    background: root.dx < 0 || root.underlay ? Theme.danger : Theme.card;

    Text {
        x: parent.width - self.width;
        width: 220px;
        text: Lang.labels.delete;
        font-size: 40px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.dx;
        width: parent.width;
        border-radius: AlarmListLayout.row-radius;
        background: root.highlighted ? Theme.surface : Theme.card;
        // Lights up at once, fades out.
        animate background { duration: root.animated && !root.highlighted ? 120ms : 0ms; }

        Text {
            x: 40px;
            width: 220px;
            text: root.alarm.time;
            font-size: 64px;
            font-weight: 500;
            color: !root.alarm.enabled ? Theme.text-faint : root.alarm.next ? Theme.accent : Theme.text;
            // A change (switched, or another alarm rings next) fades.
            animate color { duration: root.animated ? 250ms : 0ms; }
            vertical-alignment: center;
        }
        if root.alarm.name != "": Text {
            x: 290px;
            y: 22px;
            height: 52px;
            width: parent.width - 290px - 200px;
            text: root.alarm.name;
            font-size: 40px;
            overflow: elide;
            color: root.alarm.enabled ? Theme.text : Theme.text-faint;
            animate color { duration: root.animated ? 250ms : 0ms; }
            vertical-alignment: center;
        }
        for name[i] in Lang.weekdays: Text {
            x: 290px + i * 64px;
            y: root.alarm.name != "" ? 82px : 53px;
            height: 44px;
            text: name;
            font-size: 30px;
            color: root.day-on(i) && root.alarm.enabled ? Theme.text
                : root.day-on(i) ? Theme.text-dim : Theme.text-faint;
            animate color { duration: root.animated ? 250ms : 0ms; }
            vertical-alignment: center;
        }
        Switch {
            x: parent.width - self.width - 40px;
            y: (parent.height - self.height) / 2;
            on: root.alarm.enabled;
            touchable: false;
            animated: root.animated && root.switch-animated;
        }
    }
}

export component AlarmListPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    TouchArea { }

    BackButton {
        x: 24px;
        y: 20px;
        width: 240px;
        text: Lang.labels.clock;
        clicked => { AlarmList.back(); }
    }
    Button {
        x: parent.width - 264px;
        y: 20px;
        width: 240px;
        kind: ButtonKind.primary;
        icon: IconKind.plus;
        text: Lang.labels.new-alarm;
        on-press: true;
        clicked => { AlarmList.add(); }
    }
    if AlarmList.error != "": Text {
        x: 288px;
        y: 20px;
        width: parent.width - 2 * 288px;
        height: 88px;
        text: AlarmList.error;
        font-size: 30px;
        color: Theme.error;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if AlarmList.rows.length == 0: Text {
        y: 300px;
        width: parent.width;
        height: 120px;
        text: Lang.labels.no-alarms;
        font-size: 40px;
        color: Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    view := Rectangle {
        x: AlarmListLayout.x;
        y: AlarmListLayout.y;
        width: AlarmListLayout.width;
        height: AlarmListLayout.height;
        clip: true;

        property <length> pitch: AlarmListLayout.pitch;
        // A tap this close to a row's right edge toggles its switch.
        property <length> switch-area: 220px;
        property <Gesture> gesture;
        // The row under the finger, -1 for none.
        property <int> touched: -1;
        // The row drawn as active (lit up, or its highlight fading), -1
        // for none. Set only when there is something to show: changes to the
        // hidden row then repaint nothing.
        property <int> active: -1;
        // The finger has rested on the row for `hold-timer` (40 ms): only
        // then it lights up, so a touch that turns into a scroll or swipe
        // right away changes nothing on the page. Not on the switch: a
        // toggle does not light the row up.
        property <bool> held;
        // The active row's highlight is still fading after the finger left;
        // it is drawn until then. Drawing it on top of its row for longer
        // would blend the rounded corners twice.
        property <bool> settling;
        // The held row shows its highlight.
        property <bool> pressing: ta.pressed && self.touched == self.active
            && self.gesture == Gesture.undecided && self.held;

        // The layer shows the rows itself while it moves them.
        property <bool> layer-active: AlarmList.layer-active;
        changed layer-active => {
            if (self.layer-active) {
                self.active = -1;
            }
        }

        pure function row-at(y: length) -> int {
            let i = Math.floor((y + AlarmList.scroll) / self.pitch);
            if (i < 0 || i >= AlarmList.rows.length
                    || y + AlarmList.scroll - i * self.pitch > AlarmListLayout.row-height) {
                return -1;
            }
            return i;
        }
        // No feedback left to show: the active row goes away.
        function release-active() {
            if (!view.pressing) {
                view.active = -1;
            }
        }
        // Keep the active row drawn while its highlight fades.
        function settle() {
            view.settling = true;
            settle-timer.running = true;
            settle-timer.restart();
        }

        for alarm[i] in AlarmList.rows: Row {
            y: i * view.pitch - AlarmList.scroll;
            width: parent.width;
            alarm: alarm;
        }

        Row {
            visible: view.active >= 0 && view.active < AlarmList.rows.length && !AlarmList.layer-active
                && (view.pressing || view.settling);
            y: view.active * view.pitch - AlarmList.scroll;
            width: parent.width;
            alarm: AlarmList.rows[view.active];
            highlighted: view.pressing;
            switch-animated: false;
        }

        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    hold-timer.running = true;
                    hold-timer.restart();
                    view.touched = view.row-at(self.mouse-y);
                } else if (e.kind == PointerEventKind.up) {
                    let i = view.touched;
                    let toggles = view.gesture == Gesture.undecided && i >= 0
                        && self.mouse-x > self.width - view.switch-area;
                    // Feedback was shown: let it fade. Not after a toggle:
                    // the switch slides in the row below.
                    let animates = !toggles && view.pressing;
                    if (view.gesture == Gesture.undecided && i >= 0) {
                        if (toggles) {
                            AlarmList.toggle(AlarmList.rows[i].id, !AlarmList.rows[i].enabled);
                        } else {
                            AlarmList.open(AlarmList.rows[i].id);
                        }
                    }
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    if (animates) {
                        view.settle();
                    } else {
                        view.release-active();
                    }
                } else if (e.kind == PointerEventKind.cancel) {
                    let animates = view.pressing;
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    if (animates) {
                        view.settle();
                    } else {
                        view.release-active();
                    }
                }
            }
            moved => {
                // The layer takes scrolls and swipes over (this page gets a
                // cancel). A move it did not take (a list that fits the
                // view, no row under the finger) is neither one nor a tap.
                if (view.gesture == Gesture.undecided
                        && (Math.abs(self.mouse-x - self.pressed-x) > AlarmListLayout.slop
                            || Math.abs(self.mouse-y - self.pressed-y) > AlarmListLayout.slop)) {
                    view.gesture = Gesture.ignore;
                }
            }
        }

        // Short enough to feel immediate; a flick passes `slop` sooner.
        hold-timer := Timer {
            interval: 40ms;
            running: false;
            triggered => {
                self.running = false;
                if (ta.pressed && view.gesture == Gesture.undecided && view.touched >= 0
                        && ta.pressed-x <= view.width - view.switch-area) {
                    view.held = true;
                    view.active = view.touched;
                }
            }
        }

        // Longer than the highlight's fade (120 ms).
        settle-timer := Timer {
            interval: 150ms;
            running: false;
            triggered => {
                self.running = false;
                view.settling = false;
                view.release-active();
            }
        }
    }
}

// One row as the list layer renders it into its ring: on the list's
// background, with the gap below. Same component as the page's rows, so
// the pixels match when the page takes over. Not animated: it shows one
// alarm after the other and is rendered right after each change. Shown by
// a second `AppWindow` in an offscreen window (`Page.alarm-list-row`): a
// window component of its own would embed every font a second time (3 MB
// of flash).
export component ListRowPage inherits Rectangle {
    in property <AlarmRow> alarm;
    // For the pictures of a swipe (`Row`): content offset, highlight, and
    // `underlay`: the row on the delete button's red, which shows around
    // the content's right corners once it is swiped (here those corners
    // coincide with the row's own, so a square of red goes behind).
    in property <length> dx;
    in property <bool> highlighted;
    in property <bool> underlay;

    width: AlarmListLayout.width;
    height: AlarmListLayout.pitch;
    background: Theme.background;

    if root.underlay: Rectangle {
        y: 0;
        width: parent.width;
        height: AlarmListLayout.row-height;
        background: Theme.danger;
    }
    Row {
        y: 0;
        width: parent.width;
        alarm: root.alarm;
        dx: root.dx;
        highlighted: root.highlighted;
        underlay: root.underlay;
        animated: false;
    }
}
