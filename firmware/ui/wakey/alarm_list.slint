// The alarms, one row each, sorted by time. The one that rings next has
// its time in amber. Tap a row to edit it, its switch to turn it on or off,
// swipe it left to delete (a "Löschen" button appears; swiping all the way
// deletes at once). "+ Neu" adds one.
//
// ┌ ‹ Uhr ──────────────────────────────────────── + Neu ┐
// │ 06:30  Arbeit                               (  ●) │
// │        Mo Di Mi Do Fr Sa So                        │
// │ 07:15  Mo Di Mi Do Fr Sa So                 (  ●) │
// └────────────────────────────────────────────────────┘
//
// Scrolling is the firmware's list layer (`ui/list_layer.rs`): it sees every
// touch first and takes a touch over once it moves more than `slop`
// mostly vertically (this page then gets a cancel); while the list moves it
// copies pre-rendered rows (`ListRowPage`) by DMA, and when it stops it
// sets `AlarmList.scroll` and this page draws the list again, the same
// pixels. A touch that moves sideways first stays here: a swipe. So this
// page handles taps, swipes and switches on the still list.
//
// The rows only draw the alarms; none of them depends on the touch state,
// so a press or a swipe does not repaint the list. One more row, the
// "active" one, is drawn over the row being touched, swiped or left open,
// with the same alarm plus highlight and offset, and only it repaints.

import { Theme, Button, BackButton, Switch } from "theme.slint";

// What the finger on the still list is doing (scrolls are the layer's).
enum Gesture {
    // Down, not moved far enough to tell.
    undecided,
    // Swiping the touched row sideways.
    swipe,
    // The touch only closed an open row, or dragged a list that fits the
    // view: nothing happens on release.
    ignore,
}

// Where the list is, read by the list layer too (`app/alarm_list.rs`).
export global AlarmListLayout {
    out property <length> x: 40px;
    out property <length> y: 132px;
    out property <length> width: 1200px;
    out property <length> height: 588px;
    // Row height, the space below each row, and both together.
    out property <length> row-height: 150px;
    out property <length> gap: 12px;
    out property <length> pitch: self.row-height + self.gap;
    // How far a finger moves before the touch counts as a scroll or a
    // swipe.
    out property <length> slop: 12px;
    // Width of the delete button behind a swiped row.
    out property <length> reveal: 220px;
}

export struct AlarmRow {
    id: int,
    // "06:30"
    time: string,
    // Empty: the days take its place.
    name: string,
    // Weekdays as bits: Monday = 1, Tuesday = 2, … Sunday = 64. (A plain
    // value, so Rust can compare rows; an array model compares by
    // identity.)
    days: int,
    enabled: bool,
    // Rings next (amber time).
    next: bool,
}

// Set from Rust (`app/alarm_list.rs`).
export global AlarmList {
    in property <[AlarmRow]> rows;
    // How far the still list is scrolled (0 = top); set by the list layer
    // when a scroll ends.
    in property <length> scroll;
    // The list layer is showing the list (moving): no touch feedback here.
    in property <bool> scrolling;
    callback back();
    callback add();
    callback open(int);
    callback toggle(int, bool);
    callback delete(int);
}

// One alarm. `dx`, `dragging`, `highlighted` are touch feedback (only the
// active row uses them).
component Row inherits Rectangle {
    in property <AlarmRow> alarm;
    // Width of the delete button behind the row.
    in property <length> reveal;
    // Horizontal offset of the row content (≤ 0: swiped left).
    in property <length> dx;
    // The content follows the finger (no animation).
    in property <bool> dragging;
    // Touched or being swiped.
    in property <bool> highlighted;
    // Changes animate (false: shown at once, see `ListRowPage`).
    in property <bool> animated: true;
    // The switch slides on a toggle. Off for a row that shows one alarm
    // after the other (the active row): it would slide from the previous
    // alarm's state.
    in property <bool> switch-animated: true;

    pure function day-on(i: int) -> bool {
        return Math.mod(Math.floor(root.alarm.days / Math.pow(2, i)), 2) == 1;
    }

    height: AlarmListLayout.row-height;
    // No `clip` needed: the list area clips the sliding content.
    border-radius: 28px;
    background: root.dx < 0 ? Theme.danger : Theme.card;

    Text {
        x: parent.width - root.reveal;
        width: root.reveal;
        text: "Löschen";
        font-size: 40px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.dx;
        width: parent.width;
        border-radius: 28px;
        background: root.highlighted ? Theme.surface : Theme.card;
        animate x { duration: root.dragging || !root.animated ? 0ms : 180ms; easing: ease-out; }
        // Lights up at once, fades out.
        animate background { duration: root.animated && !root.highlighted ? 120ms : 0ms; }

        Text {
            x: 40px;
            width: 220px;
            text: root.alarm.time;
            font-size: 64px;
            font-weight: 500;
            color: !root.alarm.enabled ? Theme.text-faint : root.alarm.next ? Theme.accent : Theme.text;
            vertical-alignment: center;
        }
        if root.alarm.name != "": Text {
            x: 290px;
            y: 22px;
            height: 52px;
            width: parent.width - 290px - 200px;
            text: root.alarm.name;
            font-size: 40px;
            overflow: elide;
            color: root.alarm.enabled ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
        }
        for name[i] in ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]: Text {
            x: 290px + i * 64px;
            y: root.alarm.name != "" ? 82px : 53px;
            height: 44px;
            text: name;
            font-size: 30px;
            color: root.day-on(i) && root.alarm.enabled ? Theme.text
                : root.day-on(i) ? Theme.text-dim : Theme.text-faint;
            vertical-alignment: center;
        }
        Switch {
            x: parent.width - self.width - 40px;
            y: (parent.height - self.height) / 2;
            on: root.alarm.enabled;
            touchable: false;
            animated: root.animated && root.switch-animated;
        }
    }
}

export component AlarmListPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    TouchArea { }

    BackButton {
        x: 24px;
        y: 20px;
        width: 240px;
        text: "Uhr";
        clicked => { AlarmList.back(); }
    }
    Button {
        x: parent.width - 264px;
        y: 20px;
        width: 240px;
        kind: 1;
        icon: 8;
        text: "Neu";
        clicked => { AlarmList.add(); }
    }

    if AlarmList.rows.length == 0: Text {
        y: 300px;
        width: parent.width;
        height: 120px;
        text: "Noch kein Wecker gestellt";
        font-size: 40px;
        color: Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    view := Rectangle {
        x: AlarmListLayout.x;
        y: AlarmListLayout.y;
        width: AlarmListLayout.width;
        height: AlarmListLayout.height;
        clip: true;

        property <length> pitch: AlarmListLayout.pitch;
        property <length> reveal: AlarmListLayout.reveal;
        // A tap this close to a row's right edge toggles its switch.
        property <length> switch-area: 220px;
        // A swipe past this part of the width deletes without the button.
        property <float> delete-fraction: 0.6;
        property <Gesture> gesture;
        // The row under the finger, -1 for none.
        property <int> touched: -1;
        // The row whose delete button shows, -1 for none.
        property <int> open-row: -1;
        // The row drawn as active (lit up, swiped, open or animating back),
        // -1 for none. Set only when there is something to show: changes to
        // the hidden row then repaint nothing.
        property <int> active: -1;
        // The finger has rested on the row for `hold-timer` (40 ms): only
        // then it lights up, so a touch that turns into a scroll right away
        // changes nothing on the page. Not on the switch (or the delete
        // button of an open row): a toggle does not light the row up.
        property <bool> held;
        // The active row is still animating (closing, highlight fading)
        // after the finger left; it is drawn until then. Drawing it on top
        // of its row for longer would blend the rounded corners twice.
        property <bool> settling;
        // Offset of the swiped row while the finger is down.
        property <length> swipe-dx;
        property <bool> swiping: ta.pressed && self.gesture == Gesture.swipe;
        // The touched row shows touch feedback (highlight, offset).
        property <bool> pressing: ta.pressed && self.touched == self.active
            && (self.gesture == Gesture.swipe || (self.gesture == Gesture.undecided && self.held));

        // The layer shows the rows plain while it scrolls: an open row
        // closes (it would jump when the page takes over again).
        property <bool> scrolling: AlarmList.scrolling;
        changed scrolling => {
            if (self.scrolling) {
                self.open-row = -1;
                self.active = -1;
            }
        }

        pure function row-at(y: length) -> int {
            let i = Math.floor((y + AlarmList.scroll) / self.pitch);
            if (i < 0 || i >= AlarmList.rows.length
                    || y + AlarmList.scroll - i * self.pitch > AlarmListLayout.row-height) {
                return -1;
            }
            return i;
        }
        // No feedback left to show: the active row goes away.
        function release-active() {
            if (!view.pressing && view.open-row != view.active) {
                view.active = -1;
            }
        }
        // Keep the active row drawn while it animates back (closing, the
        // highlight fading).
        function settle() {
            view.settling = true;
            settle-timer.running = true;
            settle-timer.restart();
        }
        // Deletes row `i`. The active row is hidden first: the next alarm
        // moves into its place and must not slide back from the swipe.
        function delete(i: int) {
            view.open-row = -1;
            view.active = -1;
            AlarmList.delete(AlarmList.rows[i].id);
        }

        for alarm[i] in AlarmList.rows: Row {
            y: i * view.pitch - AlarmList.scroll;
            width: parent.width;
            alarm: alarm;
            reveal: view.reveal;
        }

        Row {
            visible: view.active >= 0 && view.active < AlarmList.rows.length && !AlarmList.scrolling
                && (view.pressing || view.open-row == view.active || view.settling);
            y: view.active * view.pitch - AlarmList.scroll;
            width: parent.width;
            alarm: AlarmList.rows[view.active];
            reveal: view.reveal;
            // Open only for a real row: with none (-1 == -1) the hidden row
            // sat at the open offset and slid in at the first press.
            dx: view.swiping ? view.swipe-dx
                : view.active >= 0 && view.active == view.open-row ? -view.reveal : 0;
            dragging: view.swiping;
            highlighted: view.pressing;
            switch-animated: false;
        }

        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    hold-timer.running = true;
                    hold-timer.restart();
                    view.touched = view.row-at(self.mouse-y);
                    view.swipe-dx = view.touched == view.open-row && view.open-row >= 0 ? -view.reveal : 0;
                    if (view.open-row >= 0 && view.touched != view.open-row) {
                        // A touch elsewhere only closes the open row.
                        view.open-row = -1;
                        view.gesture = Gesture.ignore;
                        view.settle();
                    }
                } else if (e.kind == PointerEventKind.up) {
                    let i = view.touched;
                    let toggles = view.gesture == Gesture.undecided && i >= 0 && view.open-row != i
                        && self.mouse-x > self.width - view.switch-area;
                    // Feedback was shown, or an open row closes: animate it.
                    // Not after a toggle: the switch slides in the row below.
                    let animates = !toggles && (view.pressing || (i >= 0 && i == view.open-row));
                    if (view.gesture == Gesture.swipe && i >= 0) {
                        if (view.swipe-dx < -self.width * view.delete-fraction) {
                            view.delete(i);
                        } else {
                            view.open-row = view.swipe-dx < -view.reveal / 2 ? i : -1;
                        }
                    } else if (view.gesture == Gesture.undecided && i >= 0) {
                        if (view.open-row == i) {
                            view.open-row = -1;
                            if (self.mouse-x > self.width - view.reveal) {
                                view.delete(i);
                            }
                        } else if (toggles) {
                            AlarmList.toggle(AlarmList.rows[i].id, !AlarmList.rows[i].enabled);
                        } else {
                            AlarmList.open(AlarmList.rows[i].id);
                        }
                    }
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    if (animates) {
                        view.settle();
                    } else {
                        view.release-active();
                    }
                } else if (e.kind == PointerEventKind.cancel) {
                    let animates = view.pressing;
                    view.gesture = Gesture.undecided;
                    view.held = false;
                    if (animates) {
                        view.settle();
                    } else {
                        view.release-active();
                    }
                }
            }
            moved => {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                // Same rule as the list layer, which takes the touch over
                // when it is mostly vertical.
                if (view.gesture == Gesture.undecided && view.touched >= 0
                        && Math.abs(dx) > AlarmListLayout.slop && Math.abs(dx) > Math.abs(dy)) {
                    view.gesture = Gesture.swipe;
                    view.active = view.touched;
                } else if (view.gesture == Gesture.undecided
                        && Math.abs(dy) > AlarmListLayout.slop && Math.abs(dy) >= Math.abs(dx)) {
                    // A vertical drag the layer did not take (the list fits
                    // the view): neither a scroll nor a tap.
                    view.gesture = Gesture.ignore;
                }
                if (view.gesture == Gesture.swipe) {
                    view.swipe-dx = Math.min(0px, (view.open-row == view.touched ? -view.reveal : 0px) + dx);
                }
            }
        }

        // Short enough to feel immediate; a flick passes `slop` sooner.
        hold-timer := Timer {
            interval: 40ms;
            running: false;
            triggered => {
                self.running = false;
                if (ta.pressed && view.gesture == Gesture.undecided && view.touched >= 0
                        && ta.pressed-x <= view.width - view.switch-area) {
                    view.held = true;
                    view.active = view.touched;
                }
            }
        }

        // Longer than the row's animations (180 ms offset, 120 ms highlight).
        settle-timer := Timer {
            interval: 200ms;
            running: false;
            triggered => {
                self.running = false;
                view.settling = false;
                view.release-active();
            }
        }
    }
}

// One row as the list layer renders it into its ring: on the list's
// background, with the gap below. Same component as the page's rows, so
// the pixels match when the page takes over. Not animated: it shows one
// alarm after the other and is rendered right after each change. Shown by
// a second `AppWindow` in an offscreen window (page 5): a window component
// of its own would embed every font a second time (3 MB of flash).
export component ListRowPage inherits Rectangle {
    in property <AlarmRow> alarm;
    width: AlarmListLayout.width;
    height: AlarmListLayout.pitch;
    background: Theme.background;

    Row {
        y: 0;
        width: parent.width;
        alarm: root.alarm;
        reveal: AlarmListLayout.reveal;
        animated: false;
    }
}
