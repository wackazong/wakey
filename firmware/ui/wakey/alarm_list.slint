// The alarms, one row each, sorted by time. The one that rings next has
// its time in amber. Tap a row to edit it, its switch to turn it on or off,
// swipe it left to delete (a "Löschen" button appears; swiping all the way
// deletes at once). "+ Neu" adds one.
//
// ┌ ‹ Uhr ──────────────────────────────────────── + Neu ┐
// │ 06:30  Arbeit                               (  ●) │
// │        Mo Di Mi Do Fr Sa So                        │
// │ 07:15  Mo Di Mi Do Fr Sa So                 (  ●) │
// └────────────────────────────────────────────────────┘
//
// One touch area handles the whole list, so scrolling and swiping cannot
// fight over a gesture: the first 12 px of movement decide whether it is a
// vertical scroll (with momentum; flicks in the same direction add up) or
// a horizontal swipe of the row under the finger. The rows only draw.

import { Theme, Button, BackButton, Switch } from "theme.slint";

export struct AlarmRow {
    id: int,
    // "06:30"
    time: string,
    // Empty: the days take its place.
    name: string,
    // Monday to Sunday.
    days: [bool],
    enabled: bool,
    // Rings next (amber time).
    next: bool,
}

// Set from Rust (`app/alarm_list.rs`).
export global AlarmList {
    in property <[AlarmRow]> rows;
    callback back();
    callback add();
    callback open(int);
    callback toggle(int, bool);
    callback delete(int);
}

component Row inherits Rectangle {
    in property <AlarmRow> alarm;
    // Horizontal offset of the row content (≤ 0).
    in property <length> dx;
    // Follows the finger (no animation).
    in property <bool> dragging;
    // Touched or being swiped.
    in property <bool> highlighted;
    in property <length> reveal;

    height: 150px;
    clip: true;
    border-radius: 28px;
    background: root.dx < 0 ? Theme.danger : Theme.card;

    Text {
        x: parent.width - root.reveal;
        width: root.reveal;
        text: "Löschen";
        font-size: 40px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.dx;
        width: parent.width;
        border-radius: 28px;
        background: root.highlighted ? Theme.surface : Theme.card;
        animate x { duration: root.dragging ? 0ms : 180ms; easing: ease-out; }
        animate background { duration: 120ms; }

        Text {
            x: 40px;
            width: 220px;
            text: root.alarm.time;
            font-size: 64px;
            font-weight: 500;
            color: !root.alarm.enabled ? Theme.text-faint : root.alarm.next ? Theme.accent : Theme.text;
            vertical-alignment: center;
        }
        if root.alarm.name != "": Text {
            x: 290px;
            y: 22px;
            height: 52px;
            width: parent.width - 290px - 200px;
            text: root.alarm.name;
            font-size: 40px;
            overflow: elide;
            color: root.alarm.enabled ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
        }
        for name[i] in ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]: Text {
            x: 290px + i * 64px;
            y: root.alarm.name != "" ? 82px : 53px;
            height: 44px;
            text: name;
            font-size: 30px;
            color: root.alarm.days[i] && root.alarm.enabled ? Theme.text
                : root.alarm.days[i] ? Theme.text-dim : Theme.text-faint;
            vertical-alignment: center;
        }
        Switch {
            x: parent.width - self.width - 40px;
            y: (parent.height - self.height) / 2;
            on: root.alarm.enabled;
            touchable: false;
        }
    }
}

export component AlarmListPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    TouchArea { }

    BackButton {
        x: 24px;
        y: 20px;
        width: 240px;
        text: "Uhr";
        clicked => { AlarmList.back(); }
    }
    Button {
        x: parent.width - 264px;
        y: 20px;
        width: 240px;
        kind: 1;
        icon: 8;
        text: "Neu";
        clicked => { AlarmList.add(); }
    }

    if AlarmList.rows.length == 0: Text {
        y: 300px;
        width: parent.width;
        height: 120px;
        text: "Noch kein Wecker gestellt";
        font-size: 40px;
        color: Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    view := Rectangle {
        x: 40px;
        y: 132px;
        width: parent.width - 80px;
        height: parent.height - 132px;
        clip: true;

        property <length> pitch: 162px;
        property <length> reveal: 220px;
        property <length> content: AlarmList.rows.length * self.pitch + 12px;
        property <length> max-scroll: Math.max(0px, self.content - self.height);
        // How far the list is scrolled (0 = top).
        property <length> scroll: 0;
        // Momentum, px per 16 ms.
        property <float> vel;
        property <bool> flinging;
        // A fling still running when the finger came down (adds to the next).
        property <float> carried;
        property <length> press-scroll;
        property <duration> last-t;
        // 0 undecided, 1 scroll, 2 swipe, 3 ignore (closed an open row).
        property <int> mode;
        // The row under the finger, -1 for none.
        property <int> touched: -1;
        // The row whose delete button shows, -1 for none.
        property <int> open-row: -1;
        property <length> swipe-dx;

        pure function row-at(y: length) -> int {
            let i = Math.floor((y + self.scroll) / self.pitch);
            if (i < 0 || i >= AlarmList.rows.length
                    || y + self.scroll - i * self.pitch > self.pitch - 12px) {
                return -1;
            }
            return i;
        }

        for alarm[i] in AlarmList.rows: Row {
            y: i * view.pitch - view.scroll;
            width: parent.width;
            alarm: alarm;
            reveal: view.reveal;
            dragging: ta.pressed && view.mode == 2 && i == view.touched;
            highlighted: ta.pressed && i == view.touched && view.mode != 1 && view.mode != 3;
            dx: ta.pressed && view.mode == 2 && i == view.touched ? view.swipe-dx
                : i == view.open-row ? -view.reveal : 0;
        }

        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    view.carried = view.flinging ? view.vel : 0;
                    view.flinging = false;
                    view.vel = 0;
                    view.mode = 0;
                    view.press-scroll = view.scroll;
                    view.last-t = animation-tick();
                    view.touched = view.row-at(self.mouse-y);
                    view.swipe-dx = view.touched == view.open-row && view.open-row >= 0 ? -view.reveal : 0;
                    if (view.open-row >= 0 && view.touched != view.open-row) {
                        // A touch elsewhere only closes the open row.
                        view.open-row = -1;
                        view.mode = 3;
                    }
                } else if (e.kind == PointerEventKind.up) {
                    if (view.mode == 1) {
                        if (animation-tick() - view.last-t > 80ms) {
                            view.vel = 0;
                        }
                        if (view.carried * view.vel > 0) {
                            view.vel += view.carried;
                        }
                        view.flinging = Math.abs(view.vel) > 0.5;
                    } else if (view.mode == 2 && view.touched >= 0) {
                        if (view.swipe-dx < -self.width * 0.6) {
                            view.open-row = -1;
                            AlarmList.delete(AlarmList.rows[view.touched].id);
                        } else {
                            view.open-row = view.swipe-dx < -view.reveal / 2 ? view.touched : -1;
                        }
                    } else if (view.mode == 0 && view.touched >= 0) {
                        if (view.open-row == view.touched) {
                            view.open-row = -1;
                            if (self.mouse-x > self.width - view.reveal) {
                                AlarmList.delete(AlarmList.rows[view.touched].id);
                            }
                        } else if (self.mouse-x > self.width - 220px) {
                            AlarmList.toggle(AlarmList.rows[view.touched].id, !AlarmList.rows[view.touched].enabled);
                        } else {
                            AlarmList.open(AlarmList.rows[view.touched].id);
                        }
                    }
                    view.mode = 0;
                } else if (e.kind == PointerEventKind.cancel) {
                    view.mode = 0;
                }
            }
            moved => {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if (view.mode == 0) {
                    if (Math.abs(dy) > 12px && Math.abs(dy) >= Math.abs(dx)) {
                        view.mode = 1;
                    } else if (Math.abs(dx) > 12px && view.touched >= 0) {
                        view.mode = 2;
                    }
                }
                if (view.mode == 1) {
                    let new = Math.clamp(view.press-scroll - dy, 0px, view.max-scroll);
                    let dt = (animation-tick() - view.last-t) / 16ms;
                    if (dt > 0) {
                        view.vel = 0.5 * view.vel + 0.5 * (new - view.scroll) / 1px / dt;
                        view.last-t = animation-tick();
                    }
                    view.scroll = new;
                } else if (view.mode == 2) {
                    view.swipe-dx = Math.min(0px, (view.open-row == view.touched ? -view.reveal : 0px) + dx);
                }
            }
        }

        Timer {
            interval: 16ms;
            running: view.flinging;
            triggered => {
                let new = Math.clamp(view.scroll + view.vel * 1px, 0px, view.max-scroll);
                if (new == view.scroll || Math.abs(view.vel) < 0.5) {
                    view.flinging = false;
                    view.vel = 0;
                } else {
                    view.scroll = new;
                    view.vel = view.vel * 0.95;
                }
            }
        }
    }
}
