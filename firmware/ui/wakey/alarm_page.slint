// Editing one alarm: time on two wheels, name, weekdays, and rows that open
// the sound page. Sichern saves, Abbrechen throws the edits away.
//
// ┌ Abbrechen ─────────────────────────────────────── Sichern ┐
// │      05   44         │ Name                  Arbeit │
// │    [ 06 : 45 ]       │ Tage                         │
// │      07   46         │ (Mo)(Di)(Mi)(Do)(Fr)(Sa)(So) │
// │                      │ Klang          Morgenlicht   │
// │ Klingelt in 9 Std.   │              ▮▮▮  < 10 s   › │
// └───────────────────────────────────────────────────────┘

import { Theme, Button, ButtonKind, Chip, Icon, IconKind, VolumeBars } from "theme.slint";
import { Wheel } from "wheel.slint";

// The values being edited; filled from Rust when the page opens
// (`src/app/alarm_page.rs`), read back on save.
export global AlarmEditor {
    in-out property <int> hour;
    in-out property <int> minute;
    in property <string> name;
    // Monday to Sunday, read by the chips when the page opens. Each chip
    // then keeps its own state and reports toggles (`day-toggled`); Rust
    // holds the selection. A binding shared by all seven chips would
    // repaint all of them on every toggle: seven side-by-side dirty
    // rectangles cost ~160 ms (see docs/pitfalls.md), one chip ~5 ms.
    in property <[bool]> days: [false, false, false, false, false, false, false];
    // At least one day selected (set from Rust).
    in property <bool> any-day;
    // The draft differs from the saved alarm (set from Rust): Sichern.
    in property <bool> changed;
    // "Klingelt in 9 Std. 14 Min.", set from Rust after every change.
    in property <string> relative;
    in property <string> sound;
    // Volume as 0–5 bars, fade-in as text ("10 s").
    in property <int> volume-bars;
    in property <string> fade;
    // Why saving failed, or empty.
    in property <string> error;

    // A wheel settled, or a day changed (summary, inactivity timeout).
    callback edited();
    // A wheel row passed the middle (click sound).
    callback ticked();
    callback day-toggled(int, bool);
    callback edit-name();
    callback open-sound();
    callback save();
    callback cancel();
}

// A row of the settings card: label left, value right, chevron. Opens a
// page, so it acts when touched.
component CardRow inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 112px;
    border-radius: 28px;
    background: ta.pressed ? Theme.surface : transparent;
    Text {
        x: 32px;
        text: root.label;
        font-size: 40px;
        color: Theme.text;
        vertical-alignment: center;
    }
    Icon {
        kind: IconKind.forward;
        x: parent.width - 64px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        color: Theme.text-faint;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
    }
    @children
}

export component AlarmPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    background: Theme.background;

    // Swallows touches between the controls.
    TouchArea { }

    Button {
        x: 24px;
        y: 20px;
        width: 240px;
        kind: ButtonKind.ghost;
        text: "Abbrechen";
        on-press: true;
        clicked => { AlarmEditor.cancel(); }
    }
    Button {
        x: parent.width - 264px;
        y: 20px;
        width: 240px;
        kind: ButtonKind.primary;
        text: "Sichern";
        on-press: true;
        enabled: AlarmEditor.any-day && AlarmEditor.changed;
        clicked => { AlarmEditor.save(); }
    }

    // Time: two wheels and the colon, centred in the left column, as tall
    // as the space above "Klingelt in" allows.
    property <length> time-x: 40px;
    property <length> time-width: 440px;
    property <length> wheels-x: self.time-x + (self.time-width - 2 * hours.width - 40px) / 2;
    property <length> band-y: hours.y + 2 * hours.row-h;
    Rectangle {
        x: root.time-x;
        y: root.band-y;
        width: root.time-width;
        height: hours.row-h;
        border-radius: 22px;
        background: Theme.surface;
    }
    hours := Wheel {
        x: root.wheels-x;
        y: 132px;
        count: 24;
        value <=> AlarmEditor.hour;
        ticked => { AlarmEditor.ticked(); }
        edited => { AlarmEditor.edited(); }
    }
    Text {
        x: root.wheels-x + hours.width;
        y: root.band-y;
        width: 40px;
        height: hours.row-h;
        text: ":";
        font-size: 72px;
        font-weight: 500;
        color: Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Wheel {
        x: root.wheels-x + hours.width + 40px;
        y: 132px;
        count: 60;
        value <=> AlarmEditor.minute;
        ticked => { AlarmEditor.ticked(); }
        edited => { AlarmEditor.edited(); }
    }
    Text {
        x: root.time-x;
        // Its bottom on the card's bottom edge.
        y: 132px + 556px - self.height;
        width: root.time-width;
        height: 48px;
        text: AlarmEditor.error != "" ? AlarmEditor.error
            : !AlarmEditor.any-day ? "Mindestens einen Tag wählen"
            : AlarmEditor.relative;
        font-size: 30px;
        color: AlarmEditor.error != "" ? Theme.error : !AlarmEditor.any-day ? Theme.warn : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Settings card: the rest of the width.
    Rectangle {
        x: root.time-x + root.time-width + 40px;
        y: 132px;
        width: root.width - self.x - 24px;
        height: 556px;
        border-radius: 28px;
        background: Theme.card;

        CardRow {
            y: 0;
            label: "Name";
            clicked => { AlarmEditor.edit-name(); }
            Text {
                x: 200px;
                width: parent.width - 200px - 80px;
                text: AlarmEditor.name != "" ? AlarmEditor.name : "optional";
                font-size: 40px;
                color: AlarmEditor.name != "" ? Theme.text : Theme.text-faint;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // Name, Tage and Klang with even gaps between what they show and
        // 32 px to the card's top and bottom edge: Name's text sits in the
        // middle of its 112 px row, Klang's two lines at 28–136 px of its
        // 160 px row. The chips sit 32 px below the Tage label.
        Text {
            x: 32px;
            y: 164px;
            height: 56px;
            text: "Tage";
            font-size: 40px;
            color: Theme.text;
            vertical-alignment: center;
        }
        // Seven chips across the card, 12 px apart.
        for name[i] in ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]: Chip {
            x: 24px + i * (self.width + 12px);
            y: 252px;
            width: (parent.width - 48px - 6 * 12px) / 7;
            text: name;
            on: AlarmEditor.days[i];
            toggled => {
                self.on = !self.on;
                AlarmEditor.day-toggled(i, self.on);
            }
        }

        // Sound, volume and fade-in: one row, one tap (the sound page
        // sets all three).
        CardRow {
            y: 388px;
            height: 160px;
            label: "Klang";
            clicked => { AlarmEditor.open-sound(); }
            Text {
                x: 200px;
                y: 24px;
                width: parent.width - 200px - 80px;
                height: 56px;
                text: AlarmEditor.sound;
                font-size: 40px;
                color: Theme.text;
                overflow: elide;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            HorizontalLayout {
                x: 200px;
                y: 88px;
                width: parent.width - 200px - 80px;
                height: 48px;
                alignment: end;
                spacing: 16px;
                VolumeBars {
                    level: AlarmEditor.volume-bars;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle { width: 8px; }
                Rectangle {
                    width: 36px;
                    Icon {
                        kind: IconKind.fade-in;
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        color: Theme.text-dim;
                    }
                }
                Text {
                    text: AlarmEditor.fade;
                    font-size: 30px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }
    }
}
