// The clock face: the time, the date, the next alarm and, only when
// something is wrong, symbols for a missing speaker or network.
//
// The time is one string ("07:38"), drawn one character per item, each as
// wide as its glyph: the spacing is the font's, and a changed digit rolls
// (the old one up and out, the new one up from below) without touching the
// others. The once-a-second update dirties only the seconds. The date
// rolls as a whole.

import { Theme, Icon, Roll } from "theme.slint";

// Set from Rust (`app/clock_screen.rs`).
export global Clock {
    // "07:38", one character per entry; seconds the same ("05").
    in property <[string]> time: ["-", "-", ":", "-", "-"];
    in property <[string]> seconds: ["-", "-"];
    // "Montag, 9. November 2026"
    in property <string> date: "";
    // Next alarm or the snooze ("Morgen 06:30").
    in property <string> alarm: "";
    // Shown as symbols, only when true: no USB speaker (alarms play on the
    // built-in one), no network (Wi-Fi failed or not set up).
    in property <bool> no-speaker;
    in property <bool> no-network;
    // Alarm: 0 idle, 1 ringing, 2 snoozed; snoozes still allowed.
    in property <int> alarm-phase: 0;
    in property <int> snoozes-left: 0;

    // Ringing: a tap anywhere snoozes (while snoozes are left); stopping
    // takes holding the button in the top-right corner for 1.5 s.
    callback snooze();
    callback stop();
    // The alarm line was touched (idle only).
    callback open-alarm();
}

export component ClockPage inherits Rectangle {
    width: 1280px;
    height: 720px;

    property <bool> ringing: Clock.alarm-phase == 1;
    property <color> digits: root.ringing ? Theme.accent : Theme.text;

    // Snooze: the whole screen, under everything else.
    TouchArea {
        enabled: root.ringing && Clock.snoozes-left > 0;
        clicked => { Clock.snooze(); }
    }

    // Never shown: embeds the time's glyphs at 280 px. Glyphs are embedded
    // per font size found in `Text` items, and `Roll` passes its size
    // through a property, which that search does not follow.
    Text {
        visible: false;
        text: "0123456789:-";
        font-size: 280px;
        font-weight: 500;
    }

    // Time: HH:MM large, seconds small to the right, on the same baseline.
    HorizontalLayout {
        x: 0;
        y: 80px;
        width: parent.width;
        height: 360px;
        alignment: center;
        spacing: 0;

        for c in Clock.time: Roll {
            width: self.natural;
            text: c;
            font-size: 280px;
            font-weight: 500;
            text-color: c == ":" ? Theme.text-faint : root.digits;
        }
        Rectangle {
            width: 120px;
            HorizontalLayout {
                x: 10px;
                y: 212px;
                width: 110px;
                height: 72px;
                alignment: start;
                for c in Clock.seconds: Roll {
                    width: self.natural;
                    text: c;
                    font-size: 64px;
                    font-weight: 500;
                    text-color: #66727f;
                }
            }
        }
    }

    Roll {
        x: 0;
        y: 440px;
        width: parent.width;
        height: 64px;
        text: !root.ringing ? Clock.date
            : Clock.snoozes-left > 0 ? "Tippen zum Schlummern · noch \{Clock.snoozes-left}×"
            : "Zum Ausschalten oben rechts halten";
        font-size: 40px;
        text-color: root.ringing ? Theme.accent : Theme.text-dim;
        horizontal-alignment: center;
    }

    // Bottom middle: the next alarm. Touching it opens the alarm list (the
    // slide starts at once).
    property <color> alarm-color: Clock.alarm-phase == 0 ? Theme.text-dim : Theme.warn;
    HorizontalLayout {
        x: 0;
        y: parent.height - 104px;
        width: parent.width;
        height: 72px;
        alignment: center;
        spacing: 16px;
        Rectangle {
            width: 40px;
            Icon {
                kind: 10;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: root.alarm-color;
            }
        }
        Text {
            text: Clock.alarm;
            font-size: 40px;
            color: root.alarm-color;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: 280px;
        y: parent.height - 136px;
        width: parent.width - 2 * 280px;
        height: 136px;
        enabled: Clock.alarm-phase == 0;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                Clock.open-alarm();
            }
        }
    }

    // Bottom right: what is missing, if anything.
    HorizontalLayout {
        x: parent.width - 40px - 104px;
        y: parent.height - 104px;
        width: 104px;
        height: 72px;
        alignment: end;
        spacing: 24px;
        if Clock.no-speaker: Rectangle {
            width: 40px;
            Icon {
                kind: 11;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: Theme.warn;
            }
        }
        if Clock.no-network: Rectangle {
            width: 40px;
            Icon {
                kind: 12;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: Theme.warn;
            }
        }
    }

    // Stop: hold until the bar has filled.
    if Clock.alarm-phase != 0: Rectangle {
        x: parent.width - 400px;
        y: 30px;
        width: 360px;
        height: 96px;
        border-radius: 48px;
        background: Theme.surface;
        border-width: 2px;
        border-color: Theme.outline;

        Rectangle {
            x: 0;
            width: stop-area.pressed ? parent.width : 0;
            animate width { duration: stop-area.pressed ? 1500ms : 0ms; }
            // Rounded itself: the software renderer clips to the parent's
            // rectangle and ignores its border radius.
            border-radius: 48px;
            background: Theme.accent-dark;
        }
        Text {
            text: "Halten: Wecker aus";
            font-size: 30px;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        stop-area := TouchArea { }
        Timer {
            interval: 1500ms;
            running: stop-area.pressed;
            triggered => { Clock.stop(); }
        }
    }
}
