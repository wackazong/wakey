// The clock face, the status line and the ringing controls.
//
// Text fields that change at different rates are separate, fixed-width
// items: the once-a-second update dirties only the seconds, the big digits
// only when they change, and digit widths cannot shift the layout.

import { Theme } from "theme.slint";

// Set from Rust (`app/clock_screen.rs`).
export global Clock {
    in property <string> hours: "--";
    in property <string> minutes: "--";
    in property <string> seconds: "--";
    // "Montag, 9. November 2026"
    in property <string> date: "";
    // Next alarm or the snooze ("Wecker morgen 06:30").
    in property <string> alarm: "";
    in property <bool> speaker-connected: false;
    // Wi-Fi: one line of text, a state for its colour (0 off, 1 busy,
    // 2 connected, 3 error) and signal bars (0–4).
    in property <string> wifi-text: "";
    in property <int> wifi-state: 0;
    in property <int> wifi-bars: 0;
    // Alarm: 0 idle, 1 ringing, 2 snoozed; snoozes still allowed.
    in property <int> alarm-phase: 0;
    in property <int> snoozes-left: 0;

    // Ringing: a tap anywhere snoozes (while snoozes are left); stopping
    // takes holding the button in the top-right corner for 1.5 s.
    callback snooze();
    callback stop();
    // The alarm line was tapped (idle only).
    callback open-alarm();
}

export component ClockPage inherits Rectangle {
    width: 1280px;
    height: 720px;

    property <bool> ringing: Clock.alarm-phase == 1;
    property <color> digits: root.ringing ? Theme.accent : Theme.text;

    // Snooze: the whole screen, under everything else.
    TouchArea {
        enabled: root.ringing && Clock.snoozes-left > 0;
        clicked => { Clock.snooze(); }
    }

    // Time: HH:MM large, seconds small to the right, on the same baseline.
    HorizontalLayout {
        x: 0;
        y: 150px;
        width: parent.width;
        height: 360px;
        alignment: center;
        spacing: 0;

        Text { text: Clock.hours; width: 380px; font-size: 280px; font-weight: 500; color: root.digits; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: ":"; width: 90px; font-size: 280px; font-weight: 500; color: Theme.text-faint; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: Clock.minutes; width: 380px; font-size: 280px; font-weight: 500; color: root.digits; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            width: 120px;
            Text {
                x: 10px;
                y: 212px;
                width: 110px;
                height: 72px;
                text: Clock.seconds;
                font-size: 64px;
                font-weight: 500;
                color: #66727f;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    Text {
        x: 0;
        y: 510px;
        width: parent.width;
        height: 56px;
        text: !root.ringing ? Clock.date
            : Clock.snoozes-left > 0 ? "Tippen zum Schlummern · noch \{Clock.snoozes-left}×"
            : "Zum Ausschalten oben rechts halten";
        font-size: 40px;
        color: root.ringing ? Theme.accent : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Bottom left: the alarm line, a button that opens the settings.
    Rectangle {
        x: 24px;
        y: parent.height - 100px;
        width: 540px;
        height: 76px;
        border-radius: 38px;
        background: alarm-area.pressed ? Theme.surface-pressed : #12171d;
        border-width: 2px;
        border-color: #222a33;

        Text {
            x: 30px;
            width: parent.width - 60px;
            text: Clock.alarm;
            font-size: 30px;
            color: Clock.alarm-phase == 0 ? Theme.text-dim : Theme.warn;
            vertical-alignment: center;
        }
        alarm-area := TouchArea {
            enabled: Clock.alarm-phase == 0;
            clicked => { Clock.open-alarm(); }
        }
    }

    // Bottom right: Wi-Fi and speaker.
    Text {
        x: parent.width - 640px;
        y: parent.height - 110px;
        width: 560px;
        height: 36px;
        text: Clock.wifi-text;
        font-size: 24px;
        color: Clock.wifi-state == 2 ? Theme.text-dim : Clock.wifi-state == 1 ? Theme.warn : Clock.wifi-state == 3 ? Theme.error : Theme.text-faint;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    // Signal bars, right of the Wi-Fi text.
    for i in 4: Rectangle {
        x: parent.width - 66px + i * 7px;
        y: parent.height - 80px - (i + 1) * 5px;
        width: 5px;
        height: (i + 1) * 5px;
        border-radius: 1px;
        background: i < Clock.wifi-bars ? (Clock.wifi-state == 2 ? Theme.text-dim : Theme.warn) : #262d35;
    }
    Text {
        x: parent.width - 440px;
        y: parent.height - 70px;
        width: 400px;
        height: 44px;
        text: Clock.speaker-connected ? "Lautsprecher verbunden" : "Kein Lautsprecher";
        font-size: 24px;
        color: Clock.speaker-connected ? Theme.ok : Theme.text-faint;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Stop: hold until the bar has filled.
    if Clock.alarm-phase != 0: Rectangle {
        x: parent.width - 400px;
        y: 30px;
        width: 360px;
        height: 96px;
        border-radius: 48px;
        clip: true;
        background: Theme.surface;
        border-width: 2px;
        border-color: Theme.outline;

        Rectangle {
            x: 0;
            width: stop-area.pressed ? parent.width : 0;
            animate width { duration: stop-area.pressed ? 1500ms : 0ms; }
            background: Theme.accent-dark;
        }
        Text {
            text: "Halten: Wecker aus";
            font-size: 30px;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        stop-area := TouchArea { }
        Timer {
            interval: 1500ms;
            running: stop-area.pressed;
            triggered => { Clock.stop(); }
        }
    }
}
