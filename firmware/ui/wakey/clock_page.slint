// The clock face: the time, the date, the next alarm and, only when
// something is wrong, symbols for a missing speaker or network, on a sky
// that follows the sun (`wakey_core::sky`, colours set from Rust). Text
// other than the digits is translucent white, readable on any sky.
//
// The time is one string ("07:38"), drawn one character per item, each as
// wide as its glyph: the spacing is the font's, and a changed digit rolls
// (the old one up and out, the new one up from below) without touching the
// others. The once-a-second update dirties only the seconds. The date
// rolls as a whole.

import { Lang } from "lang.slint";
import { Theme, Icon, IconKind, Roll } from "theme.slint";

export enum AlarmPhase { idle, ringing, snoozed }

// Set from Rust (`src/app/clock_screen.rs`).
export global Clock {
    // "07:38", one character per entry; seconds the same ("05").
    in property <[string]> time: ["-", "-", ":", "-", "-"];
    in property <[string]> seconds: ["-", "-"];
    // "Monday, 9 November 2026"
    in property <string> date: "";
    // Next alarm ("Tomorrow 06:30"), or until when it is snoozed.
    in property <string> alarm: "";
    // Shown as symbols, only when true: no USB speaker (alarms play on the
    // built-in one), no network (Wi-Fi failed or not set up).
    in property <bool> no-speaker;
    in property <bool> no-network;
    // The sky at 0, 25, 50, 75 and 100 % of the height.
    in property <color> sky-top: #0b0520;
    in property <color> sky-upper: #10072c;
    in property <color> sky-middle: #1a0b40;
    in property <color> sky-lower: #2a1260;
    in property <color> sky-bottom: #45208e;
    // The horizon is too light for white text: the bottom line is dark.
    in property <bool> bottom-light;
    // The alarm, and the snoozes still allowed.
    in property <AlarmPhase> alarm-phase;
    in property <int> snoozes-left: 0;
    // What a tap does while ringing, with the snoozes left.
    in property <string> snooze-hint;

    // Ringing: a tap anywhere snoozes (while snoozes are left); stopping
    // takes holding the button at the bottom for 1.5 s.
    callback snooze();
    callback stop();
    // The alarm line was touched (idle only).
    callback open-alarm();
}

export component ClockPage inherits Rectangle {
    width: 1280px;
    height: 720px;

    background: @linear-gradient(180deg, Clock.sky-top 0%, Clock.sky-upper 25%, Clock.sky-middle 50%, Clock.sky-lower 75%, Clock.sky-bottom 100%);

    property <bool> ringing: Clock.alarm-phase == AlarmPhase.ringing;
    property <bool> idle: Clock.alarm-phase == AlarmPhase.idle;
    property <color> soft: Theme.text.with-alpha(0.72);
    property <color> faint: Theme.text.with-alpha(0.45);

    // Snooze: the whole screen, under everything else.
    TouchArea {
        enabled: root.ringing && Clock.snoozes-left > 0;
        clicked => { Clock.snooze(); }
    }

    // Never shown: embeds the time's glyphs at 280 px. Glyphs are embedded
    // per font size found in `Text` items, and `Roll` passes its size
    // through a property, which that search does not follow.
    Text {
        visible: false;
        text: "0123456789:-";
        font-size: 280px;
        font-weight: 500;
    }

    // Time: HH:MM large, seconds small to the right, on the same baseline.
    HorizontalLayout {
        x: 0;
        y: 80px;
        width: parent.width;
        height: 360px;
        alignment: center;
        spacing: 0;

        for c in Clock.time: Roll {
            width: self.natural;
            text: c;
            font-size: 280px;
            font-weight: 500;
            text-color: c == ":" ? root.faint : Theme.text;
        }
        Rectangle {
            width: 120px;
            HorizontalLayout {
                x: 10px;
                y: 212px;
                width: 110px;
                height: 72px;
                alignment: start;
                for c in Clock.seconds: Roll {
                    width: self.natural;
                    text: c;
                    font-size: 64px;
                    font-weight: 500;
                    text-color: root.faint;
                }
            }
        }
    }

    Roll {
        x: 0;
        y: 440px;
        width: parent.width;
        height: 64px;
        // Under the time: the date; while an alarm is active, what a tap
        // does, or until when it is snoozed (the stop button has the
        // alarm line's place).
        text: root.idle ? Clock.date
            : !root.ringing ? Clock.alarm
            : Clock.snoozes-left > 0 ? Clock.snooze-hint
            : Lang.labels.stop-hint;
        font-size: 40px;
        text-color: root.soft;
        horizontal-alignment: center;
    }

    // Bottom middle: the next alarm, white on a dark horizon, dark on a
    // light one. Touching it opens the alarm list (the slide starts at
    // once).
    property <color> alarm-color: Clock.bottom-light ? Theme.background.with-alpha(0.72) : root.soft;
    property <color> symbol-color: Clock.bottom-light ? Theme.accent-dark : Theme.accent;
    if root.idle: HorizontalLayout {
        x: 0;
        y: parent.height - 104px;
        width: parent.width;
        height: 72px;
        alignment: center;
        spacing: 16px;
        Rectangle {
            width: 40px;
            Icon {
                kind: IconKind.alarm;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: root.alarm-color;
            }
        }
        Text {
            text: Clock.alarm;
            font-size: 40px;
            color: root.alarm-color;
            vertical-alignment: center;
        }
    }
    TouchArea {
        x: 280px;
        y: parent.height - 136px;
        width: parent.width - 2 * 280px;
        height: 136px;
        enabled: root.idle;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                Clock.open-alarm();
            }
        }
    }

    // Bottom right: what is missing, if anything.
    HorizontalLayout {
        x: parent.width - 40px - 104px;
        y: parent.height - 104px;
        width: 104px;
        height: 72px;
        alignment: end;
        spacing: 24px;
        if Clock.no-speaker: Rectangle {
            width: 40px;
            Icon {
                kind: IconKind.no-speaker;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: root.symbol-color;
            }
        }
        if Clock.no-network: Rectangle {
            width: 40px;
            Icon {
                kind: IconKind.no-network;
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 40px;
                color: root.symbol-color;
            }
        }
    }

    // Stop, in the alarm line's place: hold until the button has filled.
    if !root.idle: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 116px;
        width: 360px;
        height: 96px;
        border-radius: 48px;
        background: Theme.surface;
        border-width: 2px;
        border-color: Theme.outline;

        // The fill: the button again in the accent colour, uncovered from
        // the left by a clip that grows (a clip is a plain rectangle, so
        // the fill keeps the button's round ends).
        Rectangle {
            x: 0;
            width: stop-area.pressed ? parent.width : 0;
            animate width { duration: stop-area.pressed ? 1500ms : 0ms; }
            clip: true;
            Rectangle {
                x: 0;
                width: 360px;
                border-radius: 48px;
                background: Theme.accent-dark;
                border-width: 2px;
                border-color: Theme.outline;
            }
        }
        Text {
            text: Lang.labels.hold-to-stop;
            font-size: 30px;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        stop-area := TouchArea { }
        Timer {
            interval: 1500ms;
            running: stop-area.pressed;
            triggered => { Clock.stop(); }
        }
    }
}
