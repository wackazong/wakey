// Colours, icons and the touch controls shared by the pages. Dark: the
// display is the room's night light, so no large bright areas. Flat: fills
// mark controls, no outlines.
//
// Five font sizes in the whole program (every size costs flash, it is
// pre-rendered): 30 px secondary text, 40 px primary text and buttons,
// 64 px numbers, 72 px the alarm page's wheels, 280 px the clock face.

export global Theme {
    out property <color> background: #0b0e12;
    // Cards and list rows.
    out property <color> card: #12171d;
    out property <color> surface: #1c232b;
    out property <color> surface-pressed: #2a333d;
    out property <color> outline: #3a4450;
    out property <color> text: #f0f4f8;
    out property <color> text-dim: #8899aa;
    out property <color> text-faint: #4a5560;
    out property <color> accent: #ffb347;
    out property <color> accent-dark: #7a4a2a;
    // A selected list row: warm, about halfway between `card` and the
    // progress bar (`accent-dark`) in brightness, so both read in one row.
    out property <color> selected: #3a2a1e;
    out property <color> danger: #8a2f2a;
    out property <color> warn: #b08a3a;
    out property <color> error: #b0574a;
}

export enum IconKind {
    // No icon (a `Button` or key without one).
    none,
    // Chevrons.
    back,
    forward,
    check,
    play,
    stop,
    shuffle,
    backspace,
    shift,
    plus,
    // A level rising from silence, then holding.
    fade-in,
    // An alarm clock.
    alarm,
    no-speaker,
    no-network,
    // White on a red circle: a failed download.
    cross,
}

// Icons, drawn as strokes in a 24×24 box scaled to the element.
export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> color: Theme.text;
    // Line width (on screen, whatever the icon's size).
    in property <length> weight: 3.2px;
    viewbox-width: 24;
    viewbox-height: 24;
    // Play and stop are filled shapes.
    property <bool> filled: root.kind == IconKind.play || root.kind == IconKind.stop;
    stroke: root.filled ? transparent : root.color;
    fill: root.filled ? root.color : transparent;
    stroke-width: root.weight;
    commands: root.kind == IconKind.back ? "M 15 4 L 7 12 L 15 20"
        : root.kind == IconKind.forward ? "M 9 4 L 17 12 L 9 20"
        : root.kind == IconKind.check ? "M 4 12.5 L 9.5 18 L 20 6"
        : root.kind == IconKind.play ? "M 6 3 L 21 12 L 6 21 Z"
        : root.kind == IconKind.stop ? "M 5 5 L 19 5 L 19 19 L 5 19 Z"
        : root.kind == IconKind.shuffle ? "M 3 7 L 8 7 C 13 7 11 17 16 17 L 21 17 M 18 14 L 21 17 L 18 20 M 3 17 L 8 17 C 10 17 11 15.5 11.6 14 M 13.5 10 C 14 8.5 15 7 16 7 L 21 7 M 18 4 L 21 7 L 18 10"
        : root.kind == IconKind.backspace ? "M 9 5 L 21 5 L 21 19 L 9 19 L 2 12 Z M 12 9 L 18 15 M 18 9 L 12 15"
        : root.kind == IconKind.shift ? "M 12 3 L 21 12 L 16 12 L 16 20 L 8 20 L 8 12 L 3 12 Z"
        : root.kind == IconKind.plus ? "M 12 4 L 12 20 M 4 12 L 20 12"
        : root.kind == IconKind.fade-in ? "M 3 19 L 14 6 L 21 6"
        : root.kind == IconKind.alarm ? "M 12 5 A 8 8 0 1 1 11.99 5 Z M 12 9 L 12 13 L 15 15 M 2.5 6.5 L 6.5 2.5 M 21.5 6.5 L 17.5 2.5 M 6.5 19.5 L 5 21.5 M 17.5 19.5 L 19 21.5"
        : root.kind == IconKind.no-speaker ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 9.5 L 21 14.5 M 21 9.5 L 16 14.5"
        : root.kind == IconKind.no-network ? "M 2 9.5 A 15 15 0 0 1 22 9.5 M 5.5 13 A 10 10 0 0 1 18.5 13 M 9 16.5 A 5 5 0 0 1 15 16.5 M 12 20 L 12 20.2 M 3 3 L 21 21"
        : root.kind == IconKind.cross ? "M 5 5 L 19 19 M 19 5 L 5 19"
        : "";
}

export enum ButtonKind {
    normal,
    // Amber: the page's main action.
    primary,
    // Text only.
    ghost,
}

// A text button, with an optional icon left of the text.
export component Button inherits Rectangle {
    in property <string> text;
    in property <ButtonKind> kind;
    in property <bool> enabled: true;
    // Acts when touched, not when released: for buttons that change the
    // page (the slide starts at once).
    in property <bool> on-press;
    in property <IconKind> icon;
    callback clicked();

    height: 88px;
    border-radius: 44px;
    // Disabled: still a button (grey, its text faint), not bare text.
    background: root.kind == ButtonKind.ghost ? (ta.pressed && root.enabled ? Theme.surface : transparent)
        : !root.enabled ? Theme.surface
        : ta.pressed ? Theme.surface-pressed
        : root.kind == ButtonKind.primary ? Theme.accent-dark : Theme.surface;

    HorizontalLayout {
        alignment: center;
        spacing: 16px;
        if root.icon != IconKind.none: Rectangle {
            width: 36px;
            Icon {
                kind: root.icon;
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 36px;
                color: label.color;
            }
        }
        label := Text {
            text: root.text;
            font-size: 40px;
            color: !root.enabled ? Theme.text-faint
                : root.kind == ButtonKind.ghost ? Theme.text-dim : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (root.on-press && e.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
        clicked => {
            if (!root.on-press) {
                root.clicked();
            }
        }
    }
}

// "‹ Uhr": back to the previous page, top left. Acts when touched (it
// always changes the page).
export component BackButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 88px;
    border-radius: 44px;
    background: ta.pressed ? Theme.surface : transparent;
    Icon {
        kind: IconKind.back;
        x: 16px;
        width: 40px;
        height: 40px;
        y: (parent.height - self.height) / 2;
        color: Theme.text-dim;
    }
    Text {
        x: 64px;
        text: root.text;
        font-size: 40px;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.clicked();
            }
        }
    }
}

// A round weekday chip (round at any size). The owner flips `on` in
// `toggled`.
export component Chip inherits Rectangle {
    in property <string> text;
    in-out property <bool> on;
    callback toggled();

    width: 76px;
    height: self.width;
    border-radius: self.width / 2;
    background: ta.pressed ? Theme.surface-pressed : root.on ? Theme.accent-dark : Theme.surface;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        font-size: 30px;
        color: root.on ? Theme.text : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

// An on/off switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    // Slides between on and off; false shows a change at once (a
    // component reused for several rows, rendered right after each change).
    in property <bool> animated: true;
    callback toggled();

    width: 128px;
    height: 72px;
    border-radius: 36px;
    background: root.on ? Theme.accent-dark : Theme.surface;
    animate background { duration: root.animated ? 200ms : 0ms; }

    Rectangle {
        x: root.on ? parent.width - self.width - 8px : 8px;
        y: 8px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: root.on ? Theme.accent : Theme.text-dim;
        animate x { duration: root.animated ? 200ms : 0ms; easing: ease-in-out; }
        animate background { duration: root.animated ? 200ms : 0ms; }
    }
    // Off where the owner handles touches itself (the alarm list).
    in property <bool> touchable: true;
    if root.touchable: TouchArea {
        clicked => { root.toggled(); }
    }
}

// Volume as five rising bars (`level` 0–5).
export component VolumeBars inherits Rectangle {
    in property <int> level;
    width: 55px;
    height: 28px;
    for i in 5: Rectangle {
        x: i * 12px;
        y: parent.height - self.height;
        width: 7px;
        height: 8px + i * 5px;
        border-radius: 2px;
        background: i < root.level ? Theme.text : Theme.text-faint;
    }
}

// A row of pills, one selected (`selected`). As high as a Button (88 px):
// smaller targets get missed.
export component Pills inherits Rectangle {
    in property <[string]> items;
    in property <int> selected;
    callback chosen(int);
    height: 88px;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        for item[i] in root.items: Rectangle {
            width: 104px;
            border-radius: 44px;
            background: ta.pressed ? Theme.surface-pressed : i == root.selected ? Theme.accent-dark : Theme.surface;
            Text {
                text: item;
                font-size: 30px;
                color: i == root.selected ? Theme.text : Theme.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                clicked => { root.chosen(i); }
            }
        }
    }
}

// A horizontal slider, `minimum` (default 0) to 100.
export component Slider inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    callback changed-by-user(int);
    height: 72px;
    property <length> knob: 64px;
    property <length> span: root.width - root.knob;

    Rectangle {
        y: 30px;
        height: 12px;
        border-radius: 6px;
        background: Theme.surface;
    }
    Rectangle {
        x: 0;
        y: 30px;
        width: root.knob / 2 + root.span * root.value / 100;
        height: 12px;
        border-radius: 6px;
        background: Theme.text-dim.darker(30%);
    }
    Rectangle {
        x: root.span * root.value / 100;
        y: 4px;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: ta.pressed ? Theme.accent-dark.brighter(25%) : Theme.accent-dark;
    }
    ta := TouchArea {
        function set(x: length) {
            let v = Math.max(root.minimum, Math.round(Math.clamp((x - root.knob / 2) / root.span, 0, 1) * 100));
            if (v != root.value) {
                root.value = v;
                root.changed-by-user(v);
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.set(self.mouse-x);
            }
        }
        moved => { self.set(self.mouse-x); }
    }
}

// Text that rolls when it changes: the old text moves up and out of the
// box, the new one comes up from below (clipped to the box, so only that
// area repaints while it moves). `natural` is the text's width, for a
// layout around it; a change of it follows the roll.
export component Roll inherits Rectangle {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight: 400;
    in property <color> text-color: Theme.text;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    out property <length> natural: new.preferred-width;
    animate natural { duration: root.duration; easing: ease-out; }
    clip: true;

    property <duration> duration: 400ms;
    // The text shown, and the one rolling out.
    property <string> shown;
    property <string> old;
    property <duration> started;
    property <bool> rolling;
    // 0 → 1 over the roll, eased out. Depends on the animation tick only
    // while rolling: otherwise nothing redraws.
    property <float> t: root.rolling ? Math.clamp((animation-tick() - root.started) / root.duration, 0, 1) : 1;
    property <float> e: 1 - Math.pow(1 - root.t, 3);

    init => {
        root.shown = root.text;
    }
    changed text => {
        root.old = root.shown;
        root.shown = root.text;
        root.started = animation-tick();
        root.rolling = true;
        done.running = true;
        done.restart();
    }

    Text {
        visible: root.rolling;
        y: -root.e * root.height;
        width: root.width;
        height: root.height;
        text: root.old;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.text-color;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
    }
    new := Text {
        y: (1 - root.e) * root.height;
        width: root.width;
        height: root.height;
        text: root.shown;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.text-color;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
    }
    done := Timer {
        interval: root.duration;
        running: false;
        triggered => {
            self.running = false;
            root.rolling = false;
        }
    }
}

// One line of text that scrolls when it is wider than the box: endlessly
// at 40 px/s to the left, its end joined to its start by a dot. Where it
// is follows `time-ms` (a clock the page advances while the text is seen;
// offscreen copies get the time they show). Text that fits stays still.
export component Marquee inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 30px;
    in property <color> text-color: Theme.text-dim;
    in property <int> time-ms;
    clip: true;
    property <length> text-width: first.preferred-width;
    property <bool> scrolls: root.text-width > root.width;
    // The joint: a dot with a gap on each side (spaces at a text's end do
    // not count in its width).
    property <length> gap: 10px;
    property <length> period: root.text-width + root.gap + dot.preferred-width + root.gap;
    property <length> offset: root.scrolls
        ? Math.mod(root.time-ms * 0.04, Math.max(1, Math.round(root.period / 1px))) * 1px
        : 0px;
    first := Text {
        x: -root.offset;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        font-size: root.font-size;
        color: root.text-color;
        vertical-alignment: center;
    }
    dot := Text {
        visible: root.scrolls;
        x: root.text-width + root.gap - root.offset;
        width: self.preferred-width;
        height: root.height;
        text: "·";
        font-size: root.font-size;
        color: root.text-color;
        vertical-alignment: center;
    }
    // The start again after the dot (the box is narrower than the text, so
    // no second dot is ever in view).
    Text {
        visible: root.scrolls;
        x: root.period - root.offset;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        font-size: root.font-size;
        color: root.text-color;
        vertical-alignment: center;
    }
}
