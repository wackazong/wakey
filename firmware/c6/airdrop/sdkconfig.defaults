CONFIG_IDF_TARGET="esp32c6"

# As esp_hosted's image on the Tab5's C6 (../): 4 MB, DIO. Only the app is
# installed (by esp_hosted's OTA, from the P4); the C6 keeps esp_hosted's
# bootloader and partition table, copied in partitions.csv so that the build
# checks the image against the real 1920 KiB slots.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The same image from the same sources: no build date or host paths in it.
CONFIG_APP_COMPILE_TIME_DATE=n
CONFIG_APP_REPRODUCIBLE_BUILD=y

# No console: everything, the log included, leaves as frames on UART1, TX on
# IO2 to the P4's GPIO14 (link.c).
CONFIG_ESP_CONSOLE_NONE=y

CONFIG_FREERTOS_HZ=1000
# app_main's first act, esp_ota_set_boot_partition(), hashes the esp_hosted
# image deep in the stack; 3584 bytes overflow there (README.md#recovery).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# TCP receive window 64 KiB, the most without window scaling: 14 kB/s with
# the default 5760 bytes (README.md#speed).
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
