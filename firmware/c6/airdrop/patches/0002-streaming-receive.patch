 void ad_on_file(ad_file_cb_t cb, void *ctx);
 
+#ifdef AD_RX_STREAM
+/* AD_RX_STREAM builds (no PSRAM): an /Upload body is decoded while it arrives and every
+ * regular file goes to `sink` as it decodes (ad_stream.h), instead of to ad_on_file().
+ * The callbacks run on the TLS task: keep them short, and never call back into the
+ * library from them. `done` follows each transfer, `ok` true only if the whole archive
+ * arrived intact and the sender was answered 200; a file is final only then (see
+ * ad_stream.h on end()). `why` names the failure ("ok" otherwise). */
+#include "ad_stream.h"
+typedef void (*ad_upload_done_cb_t)(void *ctx, bool ok, const char *why);
+void ad_on_stream(const struct AdStreamSink *sink, ad_upload_done_cb_t done);
+#endif
+
