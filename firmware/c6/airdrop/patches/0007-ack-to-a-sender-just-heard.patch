+/* Outside the master's ch6 slots: a unicast data frame for us that arrived moments ago
+   says its sender is on ch6 NOW, whatever the master's channel sequence says. The sender's
+   own sequence decides when it listens, and under traffic it can put more slots on ch6
+   than the master. So frames queued for THAT peer (the TCP ACKs it waits for) leave
+   right away; anything else -- multicast, other peers -- still waits for the window.
+   The window-gated drain's A/B above sent early to a peer that was elsewhere; this
+   sends only to a peer just heard on the channel. The enqueue in awdl_netif_tx wakes the
+   cadence, so an ACK gets here as soon as lwIP has made it. */
+#ifndef AWDL_FOLLOW_US
+#define AWDL_FOLLOW_US 8000      /* how long after its frame the sender counts as on ch6
+                                    (its slot is 64 TU; our ACK needs a few ms through lwIP) */
+#endif
+#ifndef AWDL_FOLLOW_BUDGET
+#define AWDL_FOLLOW_BUDGET 4     /* frames per pass */
+#endif
+static void awdl_netif_follow_tx(int64_t now_us) {
+  if (!g_netif_txq) return;
+  const int64_t heard = g_rx_ucast_us;
+  if (heard == 0 || now_us - heard > AWDL_FOLLOW_US) return;
+  uint8_t peer[6];
+  memcpy(peer, (const void *)g_rx_ucast_src, 6);
+  static NetifTxFrame tf;          // the cadence task is the queue's only consumer
+  for (int budget = AWDL_FOLLOW_BUDGET; budget > 0; budget--) {
+    if (esp_timer_get_time() - heard > AWDL_FOLLOW_US) break;
+    if (!netif_inflight_room() || xQueueReceive(g_netif_txq, &tf, 0) != pdTRUE) break;
+    const uint16_t seq = (uint16_t)tf.buf[34] | ((uint16_t)tf.buf[35] << 8);
+    /* FIFO order is kept: a head frame for anyone else ends the pass, back in front. */
+    if (memcmp(tf.buf + 4, peer, 6) != 0 || !netif_inflight_begin(seq)) {
+      if (xQueueSendToFront(g_netif_txq, &tf, 0) != pdTRUE) g_diag.netif_txq_drop++;
+      break;
+    }
+    esp_err_t te = esp_wifi_80211_tx(AWDL_WIFI_IF, tf.buf, tf.len, true);
+    if (te == ESP_OK) g_diag.netif_tx_sent++;
+    else { netif_inflight_done(seq); g_diag.netif_tx_err++; g_diag.netif_tx_last_err = (int32_t)te; break; }
+  }
+}
